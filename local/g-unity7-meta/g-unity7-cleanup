#!/bin/bash
## Remove the packages of Ubuntu Unity that G Unity⁷ replaces, like
##  "emerge --depclean" of Gentoo.
##
## The installer of Ubuntu Unity installs the ubuntu-unity-desktop task and apt
##  marks its packages as manually installed, autoremove never removes them.
##  apt also keeps every installed alternative of a relation ("showtime | vlc"),
##  Portage keeps only one. The script:
##  - marks as automatically installed, if manually installed:
##    - ubuntu-unity-desktop
##    - the packages ubuntu-unity-desktop depends on or recommends and
##      g-unity7-desktop does not depend on, recommend or suggest as the first
##      alternative (the duplicates)
##    - the packages of the task the duplicates depend on or recommend
##  - removes the installed alternatives after the first one of the Depends and
##    Recommends of g-unity7-desktop (vlc of "showtime | vlc") if the first one
##    is installed and the alternative is automatically installed or of the task,
##    a package installed by the user is kept (as a package of @world); an
##    alternative is kept also if other packages would have to be removed with it
##  - removes the packages autoremove removes then

set -euo pipefail

meta=g-unity7-desktop
task=ubuntu-unity-desktop

usage() {
	cat <<-EOF
		Usage: g-unity7-cleanup [-n|--dry-run] [-y|--yes]

		Remove the packages of Ubuntu Unity that G Unity⁷ replaces: the duplicate
		applications and the other installed alternatives of the applications of
		g-unity7-desktop, as "emerge --depclean" of Gentoo.

		  -n, --dry-run  only show the packages, change nothing (no root needed)
		  -y, --yes      do not ask for confirmation
	EOF
}

dry_run=
yes=
while [[ $# -gt 0 ]]; do
	case $1 in
		-n|--dry-run) dry_run=1 ;;
		-y|--yes) yes=1 ;;
		-h|--help) usage; exit 0 ;;
		*) usage >&2; exit 2 ;;
	esac
	shift
done

die() {
	echo "g-unity7-cleanup: $*" >&2
	exit 1
}

[[ -n ${dry_run} || ${EUID} -eq 0 ]] || die "run it as root (sudo g-unity7-cleanup) or with --dry-run"

installed() {
	[[ $(dpkg-query -W -f='${db:Status-Status}' "$1" 2>/dev/null) == installed ]]
}

installed "${meta}" || die "${meta} is not installed"

## The relations of the fields $2 of a package ($1, the installed version or the
##  candidate of the archive), one per line, the alternatives separated by spaces.
relations() {
	apt-cache show --no-all-versions "$1" 2>/dev/null \
		| awk -v fields="$2" '
			BEGIN { n = split(fields, f, " "); for (i = 1; i <= n; i++) want[f[i] ":"] = 1 }
			/^[^ ]/ { take = ($1 in want) }
			take { sub(/^[^ ]+: /, ""); print }' \
		| tr ',' '\n' \
		| sed -e 's/([^)]*)//g' -e 's/\[[^]]*\]//g' -e 's/:any//g' -e 's/|/ /g' \
			-e 's/  */ /g' -e 's/^ *//' -e 's/ *$//' \
		| grep -v '^$' || true
}

## The packages of $@ that are of the task (the Task field of the archive).
of_task() {
	[[ $# -gt 0 ]] || return 0
	apt-cache show --no-all-versions "$@" 2>/dev/null \
		| awk -v task="${task}" '
			/^Package: / { pkg = $2 }
			/^Task: / {
				n = split(substr($0, 7), tasks, ", *")
				for (i = 1; i <= n; i++) if (tasks[i] == task) print pkg
			}' || true
}

declare -A manual=() keep=() in_list=()
while read -r name; do
	manual[${name%:*}]=1
done < <(apt-mark showmanual)

## The first alternatives of the relations of g-unity7-desktop are kept.
while read -r name _; do
	keep[${name}]=1
done < <(relations "${meta}" "Depends Recommends Suggests")

mark=()
add_mark() {
	local name
	for name in "$@"; do
		[[ -n ${manual[${name}]:-} && -z ${keep[${name}]:-} ]] && installed "${name}" || continue
		[[ -n ${in_list[${name}]:-} ]] || { mark+=( "${name}" ); in_list[${name}]=1; }
	done
}

## ubuntu-unity-desktop and the duplicates (the relations of the archive if it is removed already).
add_mark "${task}"
mapfile -t duplicates < <(relations "${task}" "Depends Recommends" | tr ' ' '\n')
add_mark "${duplicates[@]}"

## The packages of the task the installed duplicates depend on or recommend.
installed_duplicates=()
for name in "${duplicates[@]}"; do
	installed "${name}" && installed_duplicates+=( "${name}" )
done
if [[ ${#installed_duplicates[@]} -gt 0 ]]; then
	mapfile -t closure < <(apt-cache depends --recurse --installed --no-suggests --no-conflicts \
		--no-breaks --no-replaces --no-enhances "${installed_duplicates[@]}" 2>/dev/null \
		| grep -v '^[ <]' | sort -u || true)
	candidates=()
	for name in "${closure[@]}"; do
		[[ -n ${manual[${name}]:-} && -z ${keep[${name}]:-} ]] && candidates+=( "${name}" )
	done
	mapfile -t closure_of_task < <(of_task "${candidates[@]}")
	add_mark "${closure_of_task[@]}"
fi

## The marks applied to a copy of the apt state, the packages autoremove removes then.
tmp=$(mktemp -d)
trap 'rm -rf "${tmp}"' EXIT
states=${tmp}/extended_states
cp /var/lib/apt/extended_states "${states}" 2>/dev/null || : > "${states}"
[[ ${#mark[@]} -eq 0 ]] || apt-mark -o Dir::State::extended_states="${states}" auto "${mark[@]}" >/dev/null
declare -A autoremoved=()
while read -r name; do
	autoremoved[${name}]=1
done < <(apt-get -s -o Dir::State::extended_states="${states}" --purge autoremove 2>/dev/null \
	| awk '/^Purg / { print $2 }')

## The installed alternatives after an installed first one.
alternatives=() first_of=() user_kept=() needed_kept=()
declare -A first=()
while read -r group; do
	read -ra names <<< "${group}"
	[[ ${#names[@]} -gt 1 ]] && installed "${names[0]}" || continue
	for name in "${names[@]:1}"; do
		installed "${name}" && [[ -z ${keep[${name}]:-} && -z ${first[${name}]:-} ]] || continue
		first[${name}]=${names[0]}
		alternatives+=( "${name}" )
	done
done < <(relations "${meta}" "Depends Recommends")

declare -A alternative_of_task=()
manual_alternatives=()
for name in "${alternatives[@]}"; do
	[[ -n ${manual[${name}]:-} ]] && manual_alternatives+=( "${name}" )
done
while read -r name; do
	[[ -n ${name} ]] && alternative_of_task[${name}]=1
done < <(of_task "${manual_alternatives[@]}")

remove=()
for name in "${alternatives[@]}"; do
	if [[ -n ${manual[${name}]:-} && -z ${alternative_of_task[${name}]:-} ]]; then
		user_kept+=( "${name}" )
		continue
	fi
	## Only the alternative itself, not the packages depending on it (but the
	##  packages autoremove removes anyway, e.g. ubuntu-unity-desktop)
	others=
	while read -r other; do
		[[ ${other} == "${name}" || -n ${autoremoved[${other}]:-} ]] || others+="${other} "
	done < <(apt-get -s -o Dir::State::extended_states="${states}" --purge remove "${name}" 2>/dev/null \
		| awk '/^(Purg|Remv) / { print $2 }')
	if [[ -n ${others} ]]; then
		needed_kept+=( "${name} (needed by ${others% })" )
		continue
	fi
	remove+=( "${name}" )
	first_of+=( "${name} (${first[${name}]} is installed)" )
done

if [[ ${#mark[@]} -eq 0 && ${#remove[@]} -eq 0 ]]; then
	echo "Nothing to do, no package of Ubuntu Unity replaced by G Unity⁷ is left."
	[[ ${#user_kept[@]} -eq 0 ]] || printf 'Kept alternatives installed by you: %s\n' "${user_kept[*]}"
	exit 0
fi

## Preview with the marks applied to a copy of the apt state.
if [[ ${#remove[@]} -gt 0 ]]; then
	apt_args=( --purge --autoremove remove "${remove[@]}" )
else
	apt_args=( --purge autoremove )
fi
mapfile -t removed < <(apt-get -s -o Dir::State::extended_states="${states}" "${apt_args[@]}" 2>/dev/null \
	| awk '/^Purg / { print $2 }')

list() {
	local title=$1
	shift
	[[ $# -gt 0 ]] || return 0
	echo "${title} ($#):"
	printf '  %s\n' "$@"
	echo
}

list "Packages to mark as automatically installed" "${mark[@]}"
list "Alternatives to remove" "${first_of[@]}"
list "Kept alternatives installed by you" "${user_kept[@]}"
list "Kept alternatives other packages need" "${needed_kept[@]}"
if [[ ${#removed[@]} -gt 0 ]]; then
	list "Packages apt removes" "${removed[@]}"
else
	echo "Packages apt removes: none"
	echo
fi
echo "To keep a package, mark it as manually installed first: sudo apt-mark manual <package>"

[[ -z ${dry_run} ]] || exit 0

if [[ -z ${yes} ]]; then
	read -r -p "Remove the packages? [y/N] " answer
	[[ ${answer} == [yY]* ]] || { echo "Nothing changed."; exit 0; }
fi

[[ ${#mark[@]} -eq 0 ]] || apt-mark auto "${mark[@]}" >/dev/null
apt-get -y "${apt_args[@]}"
