# Global menu for GTK applications in the Unity session (appmenu-gtk-module), as
# the xinitrc.d script of x11-misc/appmenu-gtk-module does in Gentoo. The
# appmenu-gtk-module-common systemd user unit is not started in the Unity
# session, and it sets GTK_MODULES only for activated services. Applications
# started by other applications, such as system-config-printer from
# unity-control-center, inherit the session environment.

case :$XDG_CURRENT_DESKTOP: in
	*:Unity:*)
		case :$GTK_MODULES: in
			*:appmenu-gtk-module:*)
				;;
			*)
				GTK_MODULES=${GTK_MODULES}${GTK_MODULES:+:}appmenu-gtk-module
		esac

		if [ -z "$UBUNTU_MENUPROXY" ]; then
			UBUNTU_MENUPROXY=1
		fi

		export GTK_MODULES
		export UBUNTU_MENUPROXY
		;;
esac
