#!/bin/bash
## Remove the Ubuntu Unity packages that G Unity⁷ replaces, like Gentoo's
##  "emerge --depclean".
##
## The Ubuntu Unity installer installs the ubuntu-unity-desktop task, and apt
##  marks its packages as manually installed, so autoremove never removes them.
##  apt also keeps every installed alternative of a relation such as
##  "vlc | showtime", while Portage keeps only one. The script:
##  - asks which package to keep for each Depends and Recommends relation of
##    g-unity7-desktop that has several installed alternatives, or a different
##    alternative installed instead of the first one (apt does not install eog
##    from "eog | eom | loupe" when eom is installed). The user keeps the first
##    alternative (recommended), another one, which is installed if needed, or
##    all of them. The other alternatives are removed, unless other packages
##    would have to be removed with them.
##  - marks these packages as automatically installed if they are manually
##    installed and not kept by a choice:
##    - ubuntu-unity-desktop
##    - the packages that ubuntu-unity-desktop depends on or recommends and
##      that g-unity7-desktop does not have as a first alternative (the
##      duplicates)
##    - the task packages that the duplicates and the removed alternatives
##      depend on or recommend, such as file-roller for nemo-fileroller
##    It marks only the packages that autoremove then removes. The others are
##    still needed, for example by another desktop such as ubuntu-desktop.
##  - removes the duplicates that apt keeps as an installed alternative of
##    another relation (lightdm-gtk-greeter, xfwm4) if nothing else is removed
##    with them
##  - runs autoremove
##  - offers the G Unity⁷ Firefox and Thunderbird packages, which have Unity's
##    global menu, instead of the Ubuntu snaps, copies the snap profiles for
##    users who have no profile yet, and removes the snaps

set -euo pipefail

meta=g-unity7-desktop
task=ubuntu-unity-desktop

usage() {
	cat <<-EOF
		Usage: g-unity7-cleanup [-n|--dry-run] [-y|--yes]

		Remove the Ubuntu Unity packages that G Unity⁷ replaces: duplicate
		applications and other installed alternatives of the g-unity7-desktop
		applications, like Gentoo's "emerge --depclean". When several alternatives
		are installed, or a different one is installed instead of the recommended
		one, it asks which one to keep.

		  -n, --dry-run  show the changes without making them (no root needed)
		  -y, --yes      do not ask; keep or install the recommended alternatives
	EOF
}

dry_run=
yes=
while [[ $# -gt 0 ]]; do
	case $1 in
		-n|--dry-run) dry_run=1 ;;
		-y|--yes) yes=1 ;;
		-h|--help) usage; exit 0 ;;
		*) usage >&2; exit 2 ;;
	esac
	shift
done

## Progress spinner, shown only on a terminal, as in the overlay's
##  version_control.sh. The block runs in a subshell.
spinner=( "|" "/" "-" "\\" )
spinner_pid=

spinner_start() {
	[[ -t 2 && -z ${spinner_pid} ]] || return 0
	{
		pos=1
		printf "%s %s" "Looking for packages" "${spinner[0]}"
		while sleep 0.1; do
			printf "\b%s" "${spinner[pos]}"
			pos=$(( (pos + 1) % ${#spinner[@]} ))
		done
	} >&2 &
	spinner_pid=$!
}

spinner_stop() {
	[[ -n ${spinner_pid} ]] || return 0
	kill "${spinner_pid}" 2>/dev/null || true
	wait "${spinner_pid}" 2>/dev/null || true
	spinner_pid=
	printf "\r%22s\r" "" >&2
}

tmp=
trap 'spinner_stop; [[ -z ${tmp} ]] || rm -rf "${tmp}"' EXIT

die() {
	spinner_stop
	echo "g-unity7-cleanup: $*" >&2
	exit 1
}

[[ -n ${dry_run} || ${EUID} -eq 0 ]] || die "run as root (sudo g-unity7-cleanup) or with --dry-run"

installed() {
	[[ $(dpkg-query -W -f='${db:Status-Status}' "$1" 2>/dev/null) == installed ]]
}

installed "${meta}" || die "${meta} is not installed"
spinner_start

## Print the relations in fields $2 of package $1 (the installed version or the
##  archive candidate), one per line, with alternatives separated by spaces.
relations() {
	apt-cache show --no-all-versions "$1" 2>/dev/null \
		| awk -v fields="$2" '
			BEGIN { n = split(fields, f, " "); for (i = 1; i <= n; i++) want[f[i] ":"] = 1 }
			/^[^ ]/ { take = ($1 in want) }
			take { sub(/^[^ ]+: /, ""); print }' \
		| tr ',' '\n' \
		| sed -e 's/([^)]*)//g' -e 's/\[[^]]*\]//g' -e 's/:any//g' -e 's/|/ /g' \
			-e 's/  */ /g' -e 's/^ *//' -e 's/ *$//' \
		| grep -v '^$' || true
}

## Print the packages of $@ that belong to the task (the Task field in the archive).
of_task() {
	[[ $# -gt 0 ]] || return 0
	apt-cache show --no-all-versions "$@" 2>/dev/null \
		| awk -v task="${task}" '
			/^Package: / { pkg = $2 }
			/^Task: / {
				n = split(substr($0, 7), tasks, ", *")
				for (i = 1; i <= n; i++) if (tasks[i] == task) print pkg
			}' || true
}

declare -A manual=() keep=() in_list=()
while read -r name; do
	manual[${name%:*}]=1
done < <(apt-mark showmanual)

## Keep the first alternative of each g-unity7-desktop relation.
while read -r name _; do
	keep[${name}]=1
done < <(relations "${meta}" "Depends Recommends Suggests")

## Print the short description of a package, installed or from the archive.
summary() {
	if installed "$1"; then
		dpkg-query -W -f='${binary:Summary}' "$1" 2>/dev/null || true
	else
		apt-cache show --no-all-versions "$1" 2>/dev/null \
			| awk '/^Description(-[[:alnum:]_]+)?: / { sub(/^[^:]+: /, ""); print; exit }' || true
	fi
}

## Succeed if the archive has a version of $1 to install. LC_ALL=C because the
##  output of apt-cache policy is translated.
has_candidate() {
	local candidate
	candidate=$(LC_ALL=C apt-cache policy "$1" 2>/dev/null | awk '/^  Candidate: / { print $2 }')
	[[ -n ${candidate} && ${candidate} != "(none)" ]]
}

## Print the words of $@ as "a, b and c".
and_list() {
	local out=$1
	shift
	while [[ $# -gt 1 ]]; do
		out+=", $1"
		shift
	done
	[[ $# -eq 0 ]] || out+=" and $1"
	echo "${out}"
}

## The g-unity7-desktop relations to choose from. Relations that share the
##  first alternative and have one other alternative each become one relation:
##  the first alternative or all the others as a set joined with "+". Debian
##  has no "mate-utils | (baobab gnome-logs gnome-screenshot)", so
##  g-unity7-desktop recommends "mate-utils | baobab, mate-utils | gnome-logs".
mapfile -t relations_list < <(relations "${meta}" "Depends Recommends")
declare -A pairs=() pair_set=()
for group in "${relations_list[@]}"; do
	read -ra names <<< "${group}"
	[[ ${#names[@]} -eq 2 ]] || continue
	pairs[${names[0]}]=$(( ${pairs[${names[0]}]:-0} + 1 ))
	pair_set[${names[0]}]+=${pair_set[${names[0]}]:++}${names[1]}
done
groups=()
for group in "${relations_list[@]}"; do
	read -ra names <<< "${group}"
	if [[ ${#names[@]} -eq 2 && ${pairs[${names[0]}]} -gt 1 ]]; then
		[[ -n ${pair_set[${names[0]}]} ]] || continue
		groups+=( "${names[0]} ${pair_set[${names[0]}]}" )
		pair_set[${names[0]}]=
	else
		groups+=( "${group}" )
	fi
done

## Print a relation as text, including its sets.
relation_text() {
	local text=${1// / | }
	echo "${text//+/ + }"
}

## Print the installed packages of the alternatives $@. A set is joined with "+".
installed_of() {
	local name part parts
	for name in "$@"; do
		read -ra parts <<< "${name//+/ }"
		for part in "${parts[@]}"; do
			installed "${part}" && echo "${part}"
		done
	done
	return 0
}

## Print the packages of alternative $1 that must be installed with it: not
##  installed, but available in the archive.
missing_of() {
	local part
	for part in ${1//+/ }; do
		installed "${part}" || ! has_candidate "${part}" || echo "${part}"
	done
	return 0
}

## Succeed if a package of alternative $1 has already been decided.
decided() {
	local part
	for part in ${1//+/ }; do
		[[ -z ${spared[${part}]:-} && -z ${reason[${part}]:-} ]] || return 0
	done
	return 1
}

## Ask about the relations that have several installed alternatives, or a
##  different alternative installed instead of the first one. Kept packages
##  (spared[]) are not marked, installed packages of the other alternatives are
##  removed (reason[]). With "change nothing", no package is marked or removed.
declare -A spared=() reason=()
candidates_remove=() install=() unchanged=() asked=
for group in "${groups[@]}"; do
	read -ra names <<< "${group}"
	[[ ${#names[@]} -gt 1 ]] || continue
	first_name=${names[0]}
	## Alternatives with an installed package that is not decided yet. The first
	##  alternative of another relation does not count.
	present=()
	for name in "${names[@]}"; do
		[[ ${name} == "${first_name}" || -z ${keep[${name}]:-} ]] || continue
		[[ -n $(installed_of "${name}") ]] && ! decided "${name}" || continue
		present+=( "${name}" )
	done
	[[ ${#present[@]} -gt 0 ]] || continue

	## Ask when two alternatives are installed, or when another one is installed
	##  instead of a first alternative that the archive has
	if installed "${first_name}" || ! has_candidate "${first_name}" || decided "${first_name}"; then
		[[ ${#present[@]} -gt 1 ]] || continue
	fi

	## List the alternatives in relation order: keep an installed one, or install
	##  one that the archive has
	options=() actions=() default=
	for name in "${names[@]}"; do
		[[ ${name} == "${first_name}" || -z ${keep[${name}]:-} ]] || continue
		mapfile -t missing < <(missing_of "${name}")
		if [[ " ${present[*]} " == *" ${name} "* ]]; then
			if [[ ${name} == *+* ]]; then
				## A set: install its missing packages too
				mapfile -t parts < <(installed_of "${name}")
				label="Keep $(and_list "${parts[@]}")"
				[[ ${#missing[@]} -eq 0 ]] || label+=", and install $(and_list "${missing[@]}")"
			else
				label="Keep ${name}: $(summary "${name}")"
			fi
			actions+=( "keep ${name}" )
		else
			[[ ${#missing[@]} -gt 0 ]] && ! decided "${name}" || continue
			if [[ ${name} == *+* ]]; then
				label="Install $(and_list "${missing[@]}")"
			else
				label="Install ${name}: $(summary "${name}")"
			fi
			actions+=( "install ${name}" )
		fi
		if [[ ${name} == "${first_name}" ]]; then
			label+=" (recommended)"
			default=${#actions[@]}
		fi
		options+=( "${label}" )
	done
	## With only one installed alternative, "Keep" already changes nothing
	if [[ ${#present[@]} -gt 1 ]]; then
		options+=( "Change nothing; I will handle it myself" )
		actions+=( "nothing" )
	fi
	default=${default:-${#actions[@]}}

	spinner_stop
	if [[ -z ${asked} ]]; then
		echo "For some applications (terminal, image viewer, …), a different package than"
		echo "the recommended one, or more than one package, is installed."
		if [[ -n ${yes} ]]; then
			echo "The recommended packages are kept or installed, and the others are removed."
		else
			echo "Choose the package to keep; the others will be removed. Press Enter to accept"
			echo "the number in brackets."
		fi
		echo
		asked=1
	fi
	mapfile -t parts < <(installed_of "${present[@]}")
	if [[ ${#present[@]} -gt 1 ]]; then
		echo "$(and_list "${parts[@]}") are installed:"
	elif [[ ${#parts[@]} -gt 1 ]]; then
		echo "$(and_list "${parts[@]}") are installed instead of ${first_name}:"
	else
		echo "${parts[0]} is installed instead of ${first_name}:"
	fi
	if [[ -n ${yes} ]]; then
		answer=${default}
		echo "  ${options[answer - 1]}"
	else
		for i in "${!options[@]}"; do
			echo "  $(( i + 1 ))) ${options[i]}"
		done
		while :; do
			read -r -p "Choice [${default}]: " answer \
				|| die "no answer; use --yes to accept the recommended choices"
			answer=${answer:-${default}}
			[[ ${answer} =~ ^[1-9][0-9]*$ && ${answer} -le ${#actions[@]} ]] && break
			echo "Enter a number from 1 to ${#actions[@]}."
		done
	fi
	echo
	spinner_start

	action=${actions[answer - 1]}
	case ${action} in
		nothing)
			while read -r part; do
				spared[${part}]=1
			done < <(installed_of "${present[@]}")
			unchanged+=( "$(relation_text "${group}")" )
			;;
		install\ *|keep\ *)
			kept=${action#* }
			if [[ ${action} == install\ * ]]; then
				mapfile -t parts < <(missing_of "${kept}")
				if [[ ${#parts[@]} -gt 1 ]]; then
					why="$(and_list "${parts[@]}") are installed instead"
				else
					why="${parts[0]} is installed instead"
				fi
			else
				read -ra parts <<< "${kept//+/ }"
				if [[ ${#parts[@]} -gt 1 ]]; then
					why="$(and_list "${parts[@]}") are kept"
				else
					why="${parts[0]} is kept"
				fi
			fi
			## Keep the chosen alternative and install its missing packages
			for part in ${kept//+/ }; do
				spared[${part}]=1
				installed "${part}" || ! has_candidate "${part}" || install+=( "${part}" )
			done
			for name in "${present[@]}"; do
				[[ ${name} == "${kept}" ]] && continue
				while read -r part; do
					reason[${part}]=${why}
					candidates_remove+=( "${part}" )
				done < <(installed_of "${name}")
			done
			;;
	esac
done

## Firefox and Thunderbird: the Ubuntu packages install snaps, while the PPA
##  provides regular packages with Unity's global menu, built from the Debian
##  sources. Their version is lower, so g-unity7-apt-pin keeps the Ubuntu
##  packages until this script installs the PPA package, which then links its
##  own pin. When the user chooses the PPA package, its language packages for
##  the system's locales are installed, the snap profiles are copied for every
##  user who has no profile yet, and the snap is removed. A PPA package older
##  than the snap is not offered: Firefox and Thunderbird do not open a profile
##  that a newer version used.
moz_install=() moz_snap_remove=() moz_copy=() moz_lines=()

## Print the version of $1 in the G Unity⁷ PPA or the staging PPA, if any.
ppa_version() {
	LC_ALL=C apt-cache madison "$1" 2>/dev/null \
		| awk -F'|' '$3 ~ /c4pp4\/g-unity7/ { gsub(/ /, "", $2); print $2; exit }'
}

## Succeed if snap $1 is installed.
snap_installed() {
	command -v snap >/dev/null && snap list "$1" >/dev/null 2>&1
}

## Print "user:home" for each user (UID 1000 to 59999) who has a snap profile
##  ($1, relative to the home directory) but no profile of the PPA package ($2).
profiles_to_copy() {
	local user uid home
	while IFS=: read -r user _ uid _ _ home _; do
		[[ ${uid} -ge 1000 && ${uid} -lt 60000 && -d ${home} ]] || continue
		[[ -d ${home}/$1 && ! -e ${home}/$2 ]] && echo "${user}:${home}"
	done < <(getent passwd)
	return 0
}

## Print the language packages of PPA package $1 (version $2) that are not
##  installed, for the locales of the system (locale -a), as language-selector
##  does for LibreOffice: <package>-l10n-<language>-<country> if the PPA has it,
##  or else <package>-l10n-<language>.
moz_l10n() {
	local pkg=$1 version=$2 locale name
	local -A seen=()
	while read -r locale; do
		[[ ${locale} =~ ^([a-z]{2,3})_([A-Z]{2}) ]] || continue
		for name in "${pkg}-l10n-${BASH_REMATCH[1]}-${BASH_REMATCH[2],,}" "${pkg}-l10n-${BASH_REMATCH[1]}"; do
			[[ -n ${seen[${name}]:-} ]] && break
			[[ $(ppa_version "${name}") == "${version}" ]] || continue
			seen[${name}]=1
			installed "${name}" || echo "${name}"
			break
		done
	done < <(locale -a 2>/dev/null)
	return 0
}

## Make the default profile in the copied profile directory $2 the profile of
##  the PPA package, as Firefox does on its first run. $3 is the install hash of
##  the package directory in profiles.ini and installs.ini. Without this,
##  Firefox creates a new profile, because the compatibility.ini of the copied
##  profile points to the snap. User $1 owns installs.ini.
moz_claim_profile() {
	local user=$1 dir=$2 hash=$3 profile
	[[ -n ${hash} && -f ${dir}/profiles.ini ]] || return 0
	grep -qx "\[Install${hash}\]" "${dir}/profiles.ini" && return 0
	## The snap's default profile: the one in its install section, or else the
	##  profile with Default=1. The snap uses one profile for all installs.
	profile=$(awk -F= '
		/^\[/ { section = $0; next }
		section ~ /^\[Install/ && $1 == "Default" && install == "" { install = $2 }
		section ~ /^\[Profile/ && $1 == "Path" { path[section] = $2 }
		section ~ /^\[Profile/ && $1 == "Default" && $2 == "1" { def = section }
		END { if (install != "") print install; else if (def != "") print path[def] }
	' "${dir}/profiles.ini")
	[[ -n ${profile} ]] || return 0
	printf '\n[Install%s]\nDefault=%s\nLocked=1\n' "${hash}" "${profile}" >> "${dir}/profiles.ini" \
		|| die "cannot write ${dir}/profiles.ini"
	printf '[%s]\nDefault=%s\nLocked=1\n\n' "${hash}" "${profile}" >> "${dir}/installs.ini" \
		|| die "cannot write ${dir}/installs.ini"
	chown "${user}:$(id -gn "${user}")" "${dir}/installs.ini"
	echo "Set ${dir}/${profile} as the default profile"
}

## moz_choice <package> <snap profile> <package profile> <name> <install hash>
##  The install hash belongs to the package directory (/usr/lib/<package>) in
##  profiles.ini. Leave it empty if it is not known.
moz_choice() {
	local pkg=$1 snap_profile=$2 deb_profile=$3 app=$4 hash=$5
	local ppa status deb_installed= snap= snap_version upstream users=() copy_text options=() actions=()
	local default=1 i answer u name
	ppa=$(ppa_version "${pkg}")
	[[ -n ${ppa} ]] || return 0
	status=$(dpkg-query -W -f='${db:Status-Status} ${Version}' "${pkg}" 2>/dev/null) || true
	[[ ${status} == "installed "*+gu7* ]] && deb_installed=1
	snap_installed "${pkg}" && snap=1
	## Nothing to choose if the snap is not installed
	[[ -n ${snap} ]] || return 0

	## A profile that a newer version used does not open in an older one
	snap_version=$(snap list "${pkg}" 2>/dev/null | awk 'NR == 2 { print $2 }')
	upstream=${ppa#*:}
	upstream=${upstream%-*}
	if [[ -n ${snap_version} ]] && dpkg --compare-versions "${snap_version%-*}" gt "${upstream}"; then
		moz_lines+=( "${app}: unchanged; the snap ${snap_version} is newer than the G Unity⁷ package ${ppa}, which could not open its profile. Run g-unity7-cleanup again after the package is updated." )
		return 0
	fi

	mapfile -t users < <(profiles_to_copy "${snap_profile}" "${deb_profile}")
	copy_text=
	if [[ ${#users[@]} -gt 1 ]]; then
		copy_text="copy the snap profiles for $(and_list "${users[@]%%:*}")"
	elif [[ ${#users[@]} -eq 1 ]]; then
		copy_text="copy the snap profile for ${users[0]%%:*}"
	fi
	if [[ -n ${deb_installed} ]]; then
		if [[ -n ${copy_text} ]]; then
			options=( "${copy_text^} and remove the snap (recommended)" )
		else
			options=( "Remove the snap (recommended)" )
		fi
		options+=( "Keep the snap as well" )
		actions=( snap nothing )
	else
		options=( "Install the G Unity⁷ package${copy_text:+, ${copy_text}} and remove the snap (recommended)"
			"Keep the Ubuntu snap" )
		actions=( deb nothing )
	fi

	spinner_stop
	if [[ -n ${deb_installed} ]]; then
		echo "Both the G Unity⁷ ${app} package and the ${app} snap are installed:"
	else
		echo "${app} is installed as an Ubuntu snap."
		echo "G Unity⁷ provides a ${app} package with Unity's global menu:"
	fi
	if [[ -n ${yes} ]]; then
		answer=${default}
		echo "  ${options[answer - 1]}"
	else
		for i in "${!options[@]}"; do
			echo "  $(( i + 1 ))) ${options[i]}"
		done
		while :; do
			read -r -p "Choice [${default}]: " answer \
				|| die "no answer; use --yes to accept the recommended choices"
			answer=${answer:-${default}}
			[[ ${answer} =~ ^[1-9][0-9]*$ && ${answer} -le ${#actions[@]} ]] && break
			echo "Enter a number from 1 to ${#actions[@]}."
		done
	fi
	echo
	spinner_start

	case ${actions[answer - 1]} in
		nothing)
			moz_lines+=( "${app}: unchanged" )
			return 0
			;;
		deb)
			moz_install+=( "${pkg}=${ppa}" )
			moz_lines+=( "${app}: install ${pkg} ${ppa} from G Unity⁷" )
			;;
	esac
	while read -r name; do
		moz_install+=( "${name}=${ppa}" )
		moz_lines+=( "${app}: install ${name} ${ppa} from G Unity⁷" )
	done < <(moz_l10n "${pkg}" "${ppa}")
	## Do not remove a running snap: a copy of an open profile may be inconsistent
	if pgrep -f "/snap/${pkg}/" >/dev/null; then
		moz_lines+=( "${app}: the snap is running; close ${app} and run g-unity7-cleanup again to remove it" )
		return 0
	fi
	for u in "${users[@]}"; do
		moz_copy+=( "${u%%:*}:${u#*:}/${snap_profile}:${u#*:}/${deb_profile}:${hash}" )
		moz_lines+=( "${app}: copy ${u#*:}/${snap_profile} to ${u#*:}/${deb_profile}" )
	done
	moz_snap_remove+=( "${pkg}" )
	moz_lines+=( "${app}: remove the snap (snapd saves a snapshot of its data)" )
}

## The install hashes are CityHash64 (version 1.0.2) of the UTF-16 path of
##  /usr/lib/firefox and /usr/lib/thunderbird. The Firefox hash is the one that
##  the G Unity⁷ Firefox wrote.
moz_choice firefox snap/firefox/common/.mozilla/firefox .mozilla/firefox Firefox 4F96D1932A9F858E
moz_choice thunderbird snap/thunderbird/common/.thunderbird .thunderbird Thunderbird FDC34C9F024745EB

mark=()
add_mark() {
	local name
	for name in "$@"; do
		[[ -n ${manual[${name}]:-} && -z ${keep[${name}]:-} && -z ${spared[${name}]:-} ]] \
			&& installed "${name}" || continue
		[[ -n ${in_list[${name}]:-} ]] || { mark+=( "${name}" ); in_list[${name}]=1; }
	done
}

## ubuntu-unity-desktop and the duplicates. If ubuntu-unity-desktop is already
##  removed, its relations come from the archive.
add_mark "${task}"
mapfile -t duplicates < <(relations "${task}" "Depends Recommends" | tr ' ' '\n')
add_mark "${duplicates[@]}"

## Task packages that the installed duplicates and the removed alternatives
##  depend on or recommend, except those of packages kept by a choice.
roots=( "${candidates_remove[@]}" )
for name in "${duplicates[@]}"; do
	[[ -z ${spared[${name}]:-} ]] && installed "${name}" && roots+=( "${name}" )
done
if [[ ${#roots[@]} -gt 0 ]]; then
	mapfile -t closure < <(apt-cache depends --recurse --installed --no-suggests --no-conflicts \
		--no-breaks --no-replaces --no-enhances "${roots[@]}" 2>/dev/null \
		| grep -v '^[ <]' | sort -u || true)
	candidates=()
	for name in "${closure[@]}"; do
		[[ -n ${manual[${name}]:-} && -z ${keep[${name}]:-} && -z ${spared[${name}]:-} ]] \
			&& candidates+=( "${name}" )
	done
	mapfile -t closure_of_task < <(of_task "${candidates[@]}")
	add_mark "${closure_of_task[@]}"
fi

## Apply the marks to a copy of the apt state and find what autoremove then
##  removes.
tmp=$(mktemp -d)
states=${tmp}/extended_states
cp /var/lib/apt/extended_states "${states}" 2>/dev/null || : > "${states}"
[[ ${#mark[@]} -eq 0 ]] || apt-mark -o Dir::State::extended_states="${states}" auto "${mark[@]}" >/dev/null
declare -A autoremoved=()
while read -r name; do
	autoremoved[${name}]=1
done < <(apt-get -s -o Dir::State::extended_states="${states}" --purge autoremove 2>/dev/null \
	| awk '/^Purg / { print $2 }')

## The alternatives to remove, except those that other packages need. Packages
##  that autoremove removes anyway, such as ubuntu-unity-desktop, do not count.
install_args=( "${install[@]/%/+}" )
remove=() reasons=() needed_kept=()
for name in "${candidates_remove[@]}"; do
	others=
	while read -r other; do
		[[ ${other} == "${name}" || -n ${autoremoved[${other}]:-} ]] || others+="${other} "
	done < <(apt-get -s -o Dir::State::extended_states="${states}" --purge remove "${name}" \
		"${install_args[@]}" 2>/dev/null | awk '/^(Purg|Remv) / { print $2 }')
	if [[ -n ${others} ]]; then
		needed_kept+=( "${name} (needed by ${others% })" )
		continue
	fi
	remove+=( "${name}" )
	reasons+=( "${name} (${reason[${name}]})" )
done

## Duplicates that autoremove keeps as an installed alternative of another
##  relation, such as lightdm-gtk-greeter for lightdm-greeter or xfwm4 for
##  x-window-manager. They are removed if no other package would be removed
##  with them. Alternatives of g-unity7-desktop are left to the choices above.
declare -A of_meta=() in_remove=()
while read -r name; do
	of_meta[${name}]=1
done < <(relations "${meta}" "Depends Recommends Suggests" | tr ' ' '\n')
dup_remove=()
for name in "${duplicates[@]}"; do
	[[ -z ${of_meta[${name}]:-} && -z ${spared[${name}]:-} && -z ${autoremoved[${name}]:-} \
		&& -z ${in_remove[${name}]:-} ]] && installed "${name}" || continue
	in_remove[${name}]=1
	others=
	while read -r other; do
		[[ ${other} == "${name}" || -n ${autoremoved[${other}]:-} ]] || others+="${other} "
	done < <(apt-get -s -o Dir::State::extended_states="${states}" --purge remove "${name}" \
		"${install_args[@]}" 2>/dev/null | awk '/^(Purg|Remv) / { print $2 }')
	[[ -n ${others} ]] && continue
	remove+=( "${name}" )
	dup_remove+=( "${name}" )
done

## Preview the result with the marks applied to a copy of the apt state.
if [[ ${#remove[@]} -gt 0 || ${#install[@]} -gt 0 ]]; then
	apt_args=( --purge --autoremove remove "${remove[@]}" "${install_args[@]}" )
else
	apt_args=( --purge autoremove )
fi
simulation=$(apt-get -s -o Dir::State::extended_states="${states}" "${apt_args[@]}" 2>/dev/null)
mapfile -t removed < <(awk '/^Purg / { print $2 }' <<< "${simulation}")
mapfile -t installs < <(awk '/^Inst / { print $2 }' <<< "${simulation}")

## Keep only the marked packages that apt then removes. The others are still
##  needed by G Unity⁷ or by another desktop (ubuntu-desktop shares most of the
##  task), so marking them would only change their state. apt removes the same
##  packages without them, because a kept package and its dependencies are
##  still needed.
declare -A removed_set=()
for name in "${removed[@]}"; do
	removed_set[${name}]=1
done
## Duplicates that are removed directly are not marked.
for name in "${dup_remove[@]}"; do
	removed_set[${name}]=
done
marked=()
for name in "${mark[@]}"; do
	[[ -z ${removed_set[${name}]:-} ]] || marked+=( "${name}" )
done
mark=( "${marked[@]}" )

if [[ ${#mark[@]} -eq 0 && ${#remove[@]} -eq 0 && ${#install[@]} -eq 0 \
	&& ${#moz_install[@]} -eq 0 && ${#moz_snap_remove[@]} -eq 0 ]]; then
	spinner_stop
	echo "Nothing to do. No Ubuntu Unity packages replaced by G Unity⁷ are left."
	[[ ${#unchanged[@]} -eq 0 ]] || printf 'Left unchanged by your choice: %s\n' "${unchanged[@]}"
	[[ ${#needed_kept[@]} -eq 0 ]] || printf 'Kept because other packages need it: %s\n' "${needed_kept[@]}"
	[[ ${#moz_lines[@]} -eq 0 ]] || printf '%s\n' "${moz_lines[@]}"
	exit 0
fi

spinner_stop

## Print a list of packages side by side as apt does, or one item per line.
list_words() {
	local title=$1 width
	shift
	[[ $# -gt 0 ]] || return 0
	width=$(tput cols 2>/dev/null) || width=80
	echo "${title} ($#):"
	printf '%s\n' "$@" | awk -v width="${width}" '
		length(line) && length(line) + 1 + length($0) > width { print line; line = "" }
		{ line = length(line) ? line " " $0 : "  " $0 }
		END { if (length(line)) print line }'
	echo
}

list_lines() {
	local title=$1
	shift
	[[ $# -gt 0 ]] || return 0
	echo "${title} ($#):"
	printf '  %s\n' "$@"
	echo
}

list_words "Alternatives to install" "${install[@]}"
list_lines "Alternatives to remove" "${reasons[@]}"
list_words "Replaced by G Unity⁷ and kept by apt only as alternatives, to be removed" "${dup_remove[@]}"
list_words "No longer needed or replaced by G Unity⁷, to be marked for autoremove" "${mark[@]}"
list_lines "Left unchanged by your choice" "${unchanged[@]}"
list_lines "Alternatives kept because other packages need them" "${needed_kept[@]}"
list_lines "Firefox and Thunderbird" "${moz_lines[@]}"
list_words "Packages apt will install" "${installs[@]}"
## Purged with their configuration files and marked with * as apt does
if [[ ${#removed[@]} -gt 0 ]]; then
	list_words "Packages apt will remove" "${removed[@]/%/*}"
else
	echo "Packages apt will remove: none"
	echo
fi
echo "To keep a package, mark it as manually installed first: sudo apt-mark manual <package>"

[[ -z ${dry_run} ]] || exit 0

if [[ -z ${yes} ]]; then
	read -r -p "Do you want to continue? [y/N] " answer
	[[ ${answer} == [yY]* ]] || { echo "No changes were made."; exit 0; }
fi

[[ ${#mark[@]} -eq 0 ]] || apt-mark auto "${mark[@]}" >/dev/null
if [[ ${#mark[@]} -gt 0 || ${#remove[@]} -gt 0 || ${#install[@]} -gt 0 ]]; then
	apt-get -y "${apt_args[@]}"
fi
## Installed first alternatives are needed only by g-unity7-desktop. Other
##  alternatives were chosen by the user and stay manual, like a package in
##  @world.
install_auto=()
for name in "${install[@]}"; do
	[[ -z ${keep[${name}]:-} ]] || install_auto+=( "${name}" )
done
[[ ${#install_auto[@]} -eq 0 ]] || apt-mark auto "${install_auto[@]}" >/dev/null

## The G Unity⁷ Firefox and Thunderbird packages (a lower version than the
##  Ubuntu packages; their pin comes with them), then the snap profiles and the
##  snaps.
if [[ ${#moz_install[@]} -gt 0 ]]; then
	apt-get -y --allow-downgrades install "${moz_install[@]}"
fi
for entry in "${moz_copy[@]}"; do
	IFS=: read -r user src dst hash <<< "${entry}"
	[[ -e ${dst} ]] && continue
	mkdir -p "$(dirname "${dst}")"
	cp -a "${src}" "${dst}" || die "cannot copy ${src}"
	chown "${user}:$(id -gn "${user}")" "$(dirname "${dst}")"
	echo "Copied ${src} to ${dst}"
	moz_claim_profile "${user}" "${dst}" "${hash}"
done
moz_failed=()
for name in "${moz_snap_remove[@]}"; do
	snap remove "${name}" || moz_failed+=( "${name}" )
done
if [[ ${#moz_failed[@]} -gt 0 ]]; then
	if [[ ${#moz_failed[@]} -gt 1 ]]; then
		echo "g-unity7-cleanup: cannot remove the $(and_list "${moz_failed[@]}") snaps; the profiles have been copied" >&2
	else
		echo "g-unity7-cleanup: cannot remove the ${moz_failed[0]} snap; the profiles have been copied" >&2
	fi
	echo "Run g-unity7-cleanup again, or remove the snap with: sudo snap remove ${moz_failed[*]}" >&2
	exit 1
fi
