From: c4pp4
Date: Sun, 1 Nov 2026 23:10:00 +0100
Subject: [PATCH 1/1] Find the profiles of the Chromium snap

Chromium of Ubuntu is a snap with the profiles in
~/snap/chromium/common/chromium/. Use them if ~/.config/chromium/ does not
exist.

Signed-off-by: c4pp4
---

diff --git a/src/unity_chromiumbookmarks_daemon.py b/src/unity_chromiumbookmarks_daemon.py
--- a/src/unity_chromiumbookmarks_daemon.py
+++ b/src/unity_chromiumbookmarks_daemon.py
@@ -44,6 +44,8 @@
 DEFAULT_RESULT_MIMETYPE = 'text/html'
 DEFAULT_RESULT_TYPE = Unity.ResultType.DEFAULT
 DEFAULT_BOOKMARKS = os.getenv("HOME") + "/.config/chromium/Default/Bookmarks"
+# The profiles of the Chromium snap
+SNAP_CONFIG_PATH = os.getenv("HOME") + "/snap/chromium/common/chromium/"
 DEFAULT_TOP_SITES = ''
 PARSE_ALL_PROFILES = True
 CHROMIUM_EXECUTABLE = '/usr/bin/chromium-browser'
@@ -63,6 +65,8 @@
 def get_chromium_profiles():
     BOOKMARKS_PATH = [DEFAULT_BOOKMARKS]
     config_path = os.getenv("HOME") + "/.config/chromium/"
+    if not os.path.isdir(config_path):
+        config_path = SNAP_CONFIG_PATH
     if not PARSE_ALL_PROFILES or not os.path.isdir(config_path):
         return BOOKMARKS_PATH
     try:
