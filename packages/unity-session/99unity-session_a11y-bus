# Start the Unity session's accessibility bus now, as 99unity-session of
# unity-base/unity does in Gentoo. at-spi-bus-launcher sets the AT_SPI_BUS
# property of the X root window. The property that unity-greeter leaves behind
# points to the greeter user's bus (/run/user/<lightdm uid>), which the session
# cannot access.

case :$XDG_CURRENT_DESKTOP: in
	*:Unity:*)
		gdbus call --session --dest org.a11y.Bus --object-path /org/a11y/bus \
			--method org.a11y.Bus.GetAddress >/dev/null 2>&1 || true
		;;
esac
