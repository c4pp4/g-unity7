#!/bin/bash
## Remove the Ubuntu Unity packages that G Unity⁷ replaces, like Gentoo's
##  "emerge --depclean".
##
## The Ubuntu Unity installer installs the ubuntu-unity-desktop task, and apt
##  marks its packages as manually installed, so autoremove never removes them.
##  apt also keeps every installed alternative of a relation such as
##  "vlc | showtime", while Portage keeps only one. The script:
##  - asks which package to keep for each Depends and Recommends relation of
##    g-unity7-desktop that has several installed alternatives, or a different
##    alternative installed instead of the first one (apt does not install eog
##    from "eog | eom | loupe" when eom is installed). The user keeps the first
##    alternative (recommended), another one, which is installed if needed, or
##    all of them. The other alternatives are removed, unless other packages
##    would have to be removed with them.
##  On a system installed from the Ubuntu Unity image, it also:
##  - marks these packages as automatically installed if they are manually
##    installed and not kept by a choice:
##    - ubuntu-unity-desktop
##    - the packages that ubuntu-unity-desktop depends on or recommends and
##      that g-unity7-desktop does not have as a first alternative (the
##      duplicates)
##    - the task packages that the duplicates and the removed alternatives
##      depend on or recommend, such as file-roller for nemo-fileroller
##    It marks only the packages that autoremove then removes. The others are
##    still needed, for example by another desktop such as ubuntu-desktop.
##  - removes the duplicates that apt keeps as an installed alternative of
##    another relation (lightdm-gtk-greeter, xfwm4) if nothing else is removed
##    with them
##  - marks the packages of the Ubuntu Unity image that G Unity⁷ does not use
##    as automatically installed: Fcitx 4 (im-config no longer supports it, and
##    G Unity⁷ uses IBus) with the KDE Frameworks it pulls in, Kvantum,
##    GParted and the libraries of the installer, and removes kdialog, which
##    apt keeps as an alternative and which keeps KDE Frameworks 6
##  On every system, it then:
##  - runs autoremove
##  - offers the G Unity⁷ Firefox and Thunderbird packages, which have Unity's
##    global menu, instead of the Ubuntu snaps, copies the snap profiles as
##    their user without replacing any existing profile, and removes the
##    snaps. Without the snap, it offers the package too. The choice between
##    Thunderbird and Evolution is part of this offer, not of the alternatives
##    above.
##  - removes the desktop files of snaps that are not installed, which the
##    Ubuntu image leaves behind, and the mount units of snap revisions that
##    are not installed, which fail at every boot
##  - purges the configuration files of PulseAudio, which installing
##    g-unity7-desktop removes for PipeWire, as its autostart file remains
##  Packages given with --keep are neither marked nor removed.

set -euo pipefail

meta=g-unity7-desktop
task=ubuntu-unity-desktop
## Copies the snap profiles of a user as that user
copy_profiles=/usr/libexec/g-unity7/copy-snap-profiles
## apt waits for the lock that unattended-upgrades often holds on a new system
apt_lock=( -o DPkg::Lock::Timeout=300 )

usage() {
	cat <<-EOF
		Usage: g-unity7-cleanup [-n|--dry-run] [-y|--yes] [-k|--keep <package>]...

		Remove the Ubuntu Unity packages that G Unity⁷ replaces: duplicate
		applications and other installed alternatives of the g-unity7-desktop
		applications, like Gentoo's "emerge --depclean". When several alternatives
		are installed, or a different one is installed instead of the recommended
		one, it asks which one to keep.

		  -n, --dry-run         show the changes without making them (no root
		                        needed)
		  -y, --yes             do not ask; keep or install the recommended
		                        alternatives and the G Unity⁷ Firefox and
		                        Thunderbird packages
		  -k, --keep <package>  neither mark nor remove the package
	EOF
}

dry_run=
yes=
declare -A keep_given=()
while [[ $# -gt 0 ]]; do
	case $1 in
		-n|--dry-run) dry_run=1 ;;
		-y|--yes) yes=1 ;;
		-k|--keep)
			[[ $# -ge 2 && $2 =~ ^[a-z0-9][a-z0-9+.-]+$ ]] || { usage >&2; exit 2; }
			keep_given[$2]=1
			shift
			;;
		--keep=*)
			[[ ${1#--keep=} =~ ^[a-z0-9][a-z0-9+.-]+$ ]] || { usage >&2; exit 2; }
			keep_given[${1#--keep=}]=1
			;;
		-h|--help) usage; exit 0 ;;
		*) usage >&2; exit 2 ;;
	esac
	shift
done

## Progress spinner, shown only on a terminal, as in the overlay's
##  version_control.sh. The block runs in a subshell.
spinner=( "|" "/" "-" "\\" )
spinner_pid=

spinner_start() {
	[[ -t 2 && -z ${spinner_pid} ]] || return 0
	{
		pos=1
		printf "%s %s" "Looking for packages" "${spinner[0]}"
		while sleep 0.1; do
			printf "\b%s" "${spinner[pos]}"
			pos=$(( (pos + 1) % ${#spinner[@]} ))
		done
	} >&2 &
	spinner_pid=$!
}

spinner_stop() {
	[[ -n ${spinner_pid} ]] || return 0
	kill "${spinner_pid}" 2>/dev/null || true
	wait "${spinner_pid}" 2>/dev/null || true
	spinner_pid=
	printf "\r%22s\r" "" >&2
}

tmp=
trap 'spinner_stop; [[ -z ${tmp} ]] || rm -rf "${tmp}"' EXIT

die() {
	spinner_stop
	echo "g-unity7-cleanup: $*" >&2
	exit 1
}

[[ -n ${dry_run} || ${EUID} -eq 0 ]] || die "run as root (sudo g-unity7-cleanup) or with --dry-run"

## Succeed if package $1 is installed, for any architecture (a Multi-Arch
##  package has a status for each one)
installed() {
	local status
	status=$(dpkg-query -W -f='${db:Status-Status}\n' "$1" 2>/dev/null) || return 1
	[[ $'\n'${status}$'\n' == *$'\n'installed$'\n'* ]]
}

installed "${meta}" || die "${meta} is not installed"
spinner_start

## Print the relations in fields $2 of package $1 (the installed version, or
##  else the archive candidate), one per line, with alternatives separated by
##  spaces.
relations() {
	local field
	if installed "$1"; then
		for field in $2; do
			dpkg-query -W -f="\${${field}}\n" "$1" 2>/dev/null || true
		done
	else
		apt-cache show --no-all-versions "$1" 2>/dev/null \
			| awk -v fields="$2" '
				BEGIN { n = split(fields, f, " "); for (i = 1; i <= n; i++) want[f[i] ":"] = 1 }
				/^[^ ]/ { take = ($1 in want) }
				take { sub(/^[^ ]+: /, ""); print }'
	fi \
		| tr ',' '\n' \
		| sed -e 's/([^)]*)//g' -e 's/\[[^]]*\]//g' -e 's/:any//g' -e 's/|/ /g' \
			-e 's/  */ /g' -e 's/^ *//' -e 's/ *$//' \
		| grep -v '^$' || true
}

## Print the packages of $@ that belong to the task (the Task field in the archive).
of_task() {
	[[ $# -gt 0 ]] || return 0
	apt-cache show --no-all-versions "$@" 2>/dev/null \
		| awk -v task="${task}" '
			/^Package: / { pkg = $2 }
			/^Task: / {
				n = split(substr($0, 7), tasks, ", *")
				for (i = 1; i <= n; i++) if (tasks[i] == task) print pkg
			}' || true
}

declare -A manual=() keep=() in_list=()
while read -r name; do
	manual[${name%:*}]=1
done < <(apt-mark showmanual)

## Keep the first alternative of each g-unity7-desktop relation.
while read -r name _; do
	keep[${name}]=1
done < <(relations "${meta}" "Depends Recommends Suggests")

## Print the short description of a package, installed or from the archive.
summary() {
	if installed "$1"; then
		dpkg-query -W -f='${binary:Summary}' "$1" 2>/dev/null || true
	else
		apt-cache show --no-all-versions "$1" 2>/dev/null \
			| awk '/^Description(-[[:alnum:]_]+)?: / { sub(/^[^:]+: /, ""); print; exit }' || true
	fi
}

## Succeed if the archive has a version of $1 to install. LC_ALL=C because the
##  output of apt-cache policy is translated.
has_candidate() {
	local candidate
	candidate=$(LC_ALL=C apt-cache policy "$1" 2>/dev/null | awk '/^  Candidate: / { print $2 }')
	[[ -n ${candidate} && ${candidate} != "(none)" ]]
}

## Print the words of $@ as "a, b and c".
and_list() {
	local out=$1
	shift
	while [[ $# -gt 1 ]]; do
		out+=", $1"
		shift
	done
	[[ $# -eq 0 ]] || out+=" and $1"
	echo "${out}"
}

## The g-unity7-desktop relations to choose from. Relations that share the
##  first alternative and have one other alternative each become one relation:
##  the first alternative or all the others as a set joined with "+". Debian
##  has no "mate-utils | (baobab gnome-logs gnome-screenshot)", so
##  g-unity7-desktop recommends "mate-utils | baobab, mate-utils | gnome-logs".
mapfile -t relations_list < <(relations "${meta}" "Depends Recommends")
declare -A pairs=() pair_set=()
for group in "${relations_list[@]}"; do
	read -ra names <<< "${group}"
	[[ ${#names[@]} -eq 2 ]] || continue
	pairs[${names[0]}]=$(( ${pairs[${names[0]}]:-0} + 1 ))
	pair_set[${names[0]}]+=${pair_set[${names[0]}]:++}${names[1]}
done
groups=()
for group in "${relations_list[@]}"; do
	read -ra names <<< "${group}"
	if [[ ${#names[@]} -eq 2 && ${pairs[${names[0]}]} -gt 1 ]]; then
		[[ -n ${pair_set[${names[0]}]} ]] || continue
		groups+=( "${names[0]} ${pair_set[${names[0]}]}" )
		pair_set[${names[0]}]=
	else
		groups+=( "${group}" )
	fi
done

## Print a relation as text, including its sets.
relation_text() {
	local text=${1// / | }
	echo "${text//+/ + }"
}

## Print the installed packages of the alternatives $@. A set is joined with "+".
installed_of() {
	local name part parts
	for name in "$@"; do
		read -ra parts <<< "${name//+/ }"
		for part in "${parts[@]}"; do
			installed "${part}" && echo "${part}"
		done
	done
	return 0
}

## Print the packages of alternative $1 that must be installed with it: not
##  installed, but available in the archive.
missing_of() {
	local part
	for part in ${1//+/ }; do
		installed "${part}" || ! has_candidate "${part}" || echo "${part}"
	done
	return 0
}

## Succeed if a package of alternative $1 has already been decided.
decided() {
	local part
	for part in ${1//+/ }; do
		[[ -z ${spared[${part}]:-} && -z ${reason[${part}]:-} ]] || return 0
	done
	return 1
}

## Ask about the relations that have several installed alternatives, or a
##  different alternative installed instead of the first one. Kept packages
##  (spared[]) are not marked, installed packages of the other alternatives are
##  removed (reason[]). With "change nothing", no package is marked or removed.
declare -A spared=() reason=()
## Packages given with --keep are kept like a choice
for name in "${!keep_given[@]}"; do
	spared[${name}]=1
done
## Shown after the name of an alternative in the choice: what the G Unity⁷
##  package adds to a package that Ubuntu also has (the Breaks of
##  g-unity7-desktop keep the installed package at the G Unity⁷ version), or the
##  applications of a package that replaces a set of alternatives.
declare -A adds=(
	[eog]="with Unity's global menu"
	[mate-utils]="with mate-screenshot, mate-disk-usage-analyzer and mate-system-log"
)
candidates_remove=() install=() unchanged=() asked=
for group in "${groups[@]}"; do
	read -ra names <<< "${group}"
	[[ ${#names[@]} -gt 1 ]] || continue
	first_name=${names[0]}
	## The Thunderbird offer below handles "thunderbird | evolution": installing
	##  thunderbird here would install the Ubuntu package with the snap
	[[ ${first_name} != thunderbird ]] || continue
	## Alternatives with an installed package that is not decided yet. The first
	##  alternative of another relation does not count.
	present=()
	for name in "${names[@]}"; do
		[[ ${name} == "${first_name}" || -z ${keep[${name}]:-} ]] || continue
		[[ -n $(installed_of "${name}") ]] && ! decided "${name}" || continue
		present+=( "${name}" )
	done
	[[ ${#present[@]} -gt 0 ]] || continue

	## Ask when two alternatives are installed, or when another one is installed
	##  instead of a first alternative that the archive has
	if installed "${first_name}" || ! has_candidate "${first_name}" || decided "${first_name}"; then
		[[ ${#present[@]} -gt 1 ]] || continue
	fi

	## List the alternatives in relation order: keep an installed one, or install
	##  one that the archive has
	options=() actions=() default=
	for name in "${names[@]}"; do
		[[ ${name} == "${first_name}" || -z ${keep[${name}]:-} ]] || continue
		mapfile -t missing < <(missing_of "${name}")
		about="${name}${adds[${name}]:+ ${adds[${name}]}}"
		if [[ " ${present[*]} " == *" ${name} "* ]]; then
			if [[ ${name} == *+* ]]; then
				## A set: install its missing packages too
				mapfile -t parts < <(installed_of "${name}")
				label="Keep $(and_list "${parts[@]}")"
				[[ ${#missing[@]} -eq 0 ]] || label+=", and install $(and_list "${missing[@]}")"
			else
				label="Keep ${about}: $(summary "${name}")"
			fi
			actions+=( "keep ${name}" )
		else
			[[ ${#missing[@]} -gt 0 ]] && ! decided "${name}" || continue
			if [[ ${name} == *+* ]]; then
				label="Install $(and_list "${missing[@]}")"
			else
				label="Install ${about}: $(summary "${name}")"
			fi
			actions+=( "install ${name}" )
		fi
		if [[ ${name} == "${first_name}" ]]; then
			label+=" (recommended)"
			default=${#actions[@]}
		fi
		options+=( "${label}" )
	done
	## With only one installed alternative, "Keep" already changes nothing
	if [[ ${#present[@]} -gt 1 ]]; then
		options+=( "Change nothing; I will handle it myself" )
		actions+=( "nothing" )
	fi
	default=${default:-${#actions[@]}}

	spinner_stop
	if [[ -z ${asked} ]]; then
		echo "For some applications (terminal, image viewer, …), a different package than"
		echo "the recommended one, or more than one package, is installed."
		if [[ -n ${yes} ]]; then
			echo "The recommended packages are kept or installed, and the others are removed."
		else
			echo "Choose the package to keep; the others will be removed. Press Enter to accept"
			echo "the number in brackets."
		fi
		echo
		asked=1
	fi
	mapfile -t parts < <(installed_of "${present[@]}")
	if [[ ${#present[@]} -gt 1 ]]; then
		echo "$(and_list "${parts[@]}") are installed:"
	elif [[ ${#parts[@]} -gt 1 ]]; then
		echo "$(and_list "${parts[@]}") are installed instead of ${first_name}:"
	else
		echo "${parts[0]} is installed instead of ${first_name}:"
	fi
	if [[ -n ${yes} ]]; then
		answer=${default}
		echo "  ${options[answer - 1]}"
	else
		for i in "${!options[@]}"; do
			echo "  $(( i + 1 ))) ${options[i]}"
		done
		while :; do
			read -r -p "Choice [${default}]: " answer \
				|| die "no answer; use --yes to accept the recommended choices"
			answer=${answer:-${default}}
			[[ ${answer} =~ ^[1-9][0-9]*$ && ${answer} -le ${#actions[@]} ]] && break
			echo "Enter a number from 1 to ${#actions[@]}."
		done
	fi
	echo
	spinner_start

	action=${actions[answer - 1]}
	case ${action} in
		nothing)
			while read -r part; do
				spared[${part}]=1
			done < <(installed_of "${present[@]}")
			unchanged+=( "$(relation_text "${group}")" )
			;;
		install\ *|keep\ *)
			kept=${action#* }
			if [[ ${action} == install\ * ]]; then
				mapfile -t parts < <(missing_of "${kept}")
				if [[ ${#parts[@]} -gt 1 ]]; then
					why="$(and_list "${parts[@]}") are installed instead"
				else
					why="${parts[0]} is installed instead"
				fi
			else
				read -ra parts <<< "${kept//+/ }"
				if [[ ${#parts[@]} -gt 1 ]]; then
					why="$(and_list "${parts[@]}") are kept"
				else
					why="${parts[0]} is kept"
				fi
			fi
			## Keep the chosen alternative and install its missing packages
			for part in ${kept//+/ }; do
				spared[${part}]=1
				installed "${part}" || ! has_candidate "${part}" || install+=( "${part}" )
			done
			for name in "${present[@]}"; do
				[[ ${name} == "${kept}" ]] && continue
				while read -r part; do
					reason[${part}]=${why}
					candidates_remove+=( "${part}" )
				done < <(installed_of "${name}")
			done
			;;
	esac
done

## The duplicates of the task and the unused packages of the Ubuntu Unity image
##  are removed only on a system installed from that image. Installing
##  g-unity7-desktop already removes the task, which depends on pulseaudio, but
##  not ubuntu-unity-settings, which only the task installs. The first run that
##  makes changes remembers it for later runs, as it removes
##  ubuntu-unity-settings as a duplicate.
unity_marker=/var/lib/g-unity7/ubuntu-unity
unity_image=
if installed "${task}" || installed ubuntu-unity-settings || [[ -e ${unity_marker} ]]; then
	unity_image=1
fi

## Firefox and Thunderbird: the Ubuntu packages install snaps, while the PPA
##  provides regular packages with Unity's global menu, built from the Debian
##  sources. Their version is lower, so g-unity7-apt-pin keeps the Ubuntu
##  packages until this script installs the PPA package, which then links its
##  own pin. When the user chooses the PPA package, its language packages for
##  the languages in use are installed, the snap profiles of every user are
##  copied as that user (added to the existing profiles, if any), and the snap
##  is removed. A PPA package older
##  than the snap is not offered: Firefox and Thunderbird do not open a profile
##  that a newer version used. Without the snap, the PPA package is offered
##  as well; Evolution is mentioned if it is installed instead of Thunderbird.
moz_install=() moz_snap_remove=() moz_copy=() moz_lines=() homes_noted=

## A switch from a snap to the package starts before the package is installed:
##  /var/lib/g-unity7/switch-<package> holds its ID until the snap is removed.
##  When a run stops in between, such as when the copy of a profile failed,
##  the next run continues the switch: the snap's default profile still becomes
##  the default profile of the package that the run installed, and
##  copy-snap-profiles does not make the copies of the switch again (it writes
##  .g-unity7-snap-copy to the package profile directory), unless the snap
##  changed the profiles since then. A run that does not remove the snap drops
##  the file of its switch.
switch_dir=/var/lib/g-unity7
copy_marker=.g-unity7-snap-copy
## The KiB that the chosen copies need on each file system (mount point)
declare -A space_needed=()
## The free space that a copy leaves at least, in KiB
space_spare=102400

## Print the free space in KiB and the mount point of the file system of path
##  $1, or of its nearest existing parent directory.
free_space() {
	local path=$1
	while [[ ! -e ${path} && ${path} == /?* ]]; do
		path=${path%/*}
	done
	df -Pk -- "${path:-/}" 2>/dev/null | awk 'NR == 2 { print $4, $6 }'
}

## Print a size in KiB in MB, rounded up
in_mb() {
	echo "$(( ($1 + 1023) / 1024 )) MB"
}

## Print the version of $1 in the G Unity⁷ PPA or the staging PPA, if any.
ppa_version() {
	LC_ALL=C apt-cache madison "$1" 2>/dev/null \
		| awk -F'|' '$3 ~ /c4pp4\/g-unity7/ { gsub(/ /, "", $2); print $2; exit }'
}

## Succeed if snap $1 is installed.
snap_installed() {
	command -v snap >/dev/null && snap list "$1" >/dev/null 2>&1
}

## Succeed if a program of snap $1 is running.
snap_running() {
	pgrep -f "/snap/$1/" >/dev/null
}

## Remove the empty revision directories in /var/snap/$1 that snapd does not
##  know. The Ubuntu image leaves the directories of the snap revisions it was
##  built with, and snapd then cannot remove /var/snap/$1 (directory not empty).
snap_orphans_remove() {
	local dir revs
	revs=" $(LC_ALL=C snap list --all "$1" 2>/dev/null | awk 'NR > 1 { printf "%s ", $3 }')" || true
	[[ ${revs} == *[0-9]* ]] || return 0
	for dir in /var/snap/"$1"/[0-9]*/; do
		[[ -d ${dir} && ${revs} != *" $(basename "${dir}") "* ]] || continue
		rmdir "${dir}" 2>/dev/null || true
	done
}

## Print "user:home" for each home directory that may have snap profiles: those
##  of the users with a UID from 1000 to 59999, and the directories in /home
##  with their owner, as snapd also looks there. This finds the users of a
##  network directory (LDAP, SSSD) too, which may have a higher UID and which
##  getent may not list.
homes() {
	local user uid home
	local -A seen=()
	while IFS=: read -r user _ uid _ _ home _; do
		[[ ${uid} -ge 1000 && ${uid} -lt 60000 && -d ${home} && -z ${seen[${home}]:-} ]] || continue
		seen[${home}]=1
		echo "${user}:${home}"
	done < <(getent passwd)
	for home in /home/*; do
		[[ -d ${home} && ! -L ${home} && -z ${seen[${home}]:-} ]] || continue
		IFS=: read -r user uid < <(stat -c '%U:%u' "${home}")
		[[ ${uid} -ge 1000 && ${user} != UNKNOWN ]] || continue
		seen[${home}]=1
		echo "${user}:${home}"
	done
	return 0
}

## Print "user:home:directory" for each user who has a profile directory of
##  snap $1 with profiles.ini, where Firefox and Thunderbird look for it
##  (nsXREDirProvider): the legacy directory $2 in $SNAP_USER_COMMON
##  (~/snap/<snap>/common) if its first directory (.mozilla, .thunderbird)
##  exists, or else the XDG directory $3 in $SNAP_USER_DATA, where the snap
##  points XDG_CONFIG_HOME. $SNAP_USER_DATA is the directory of the installed
##  revision $4 (~/snap/<snap>/<revision>), which snapd copies to each new
##  revision. The "current" link in ~/snap/<snap> may point to an older or a
##  removed revision, as only snap run updates it. The Firefox snap forces the
##  legacy directory (MOZ_LEGACY_HOME), while Thunderbird 160 creates new
##  profiles in the XDG directory.
snap_profiles() {
	local snap=$1 legacy=$2 xdg=$3 rev=$4 entry home dir
	while read -r entry; do
		home=${entry#*:}
		if [[ -d ${home}/snap/${snap}/common/${legacy%%/*} ]]; then
			dir=${home}/snap/${snap}/common/${legacy}
		elif [[ -n ${rev} ]]; then
			dir=${home}/snap/${snap}/${rev}/${xdg}
		else
			continue
		fi
		[[ -f ${dir}/profiles.ini ]] && echo "${entry}:${dir}"
	done < <(homes)
	return 0
}

## Print the languages in use: LANG and LANGUAGE in /etc/default/locale and the
##  language that each user chose (AccountsService). Not locale -a: the Ubuntu
##  installer keeps the language packs of the ISO's languages, which generate
##  their locales.
used_locales() {
	local file
	sed -n -e 's/^LANG=//p' -e 's/^LANGUAGE=//p' /etc/default/locale 2>/dev/null \
		| tr -d '"' | tr ':' '\n'
	for file in /var/lib/AccountsService/users/*; do
		[[ -f ${file} ]] && sed -n 's/^Language=//p' "${file}"
	done
	return 0
}

## Print the language packages of PPA package $1 (version $2) that are not
##  installed, for the languages in use: <package>-l10n-<language>-<country> if
##  the PPA has it, or else <package>-l10n-<language>.
moz_l10n() {
	local pkg=$1 version=$2 locale name names
	local -A seen=()
	while read -r locale; do
		[[ ${locale} =~ ^([a-z]{2,3})(_([A-Z]{2}))? ]] || continue
		names=( "${pkg}-l10n-${BASH_REMATCH[1]}" )
		[[ -z ${BASH_REMATCH[3]} ]] \
			|| names=( "${pkg}-l10n-${BASH_REMATCH[1]}-${BASH_REMATCH[3],,}" "${names[@]}" )
		for name in "${names[@]}"; do
			[[ -n ${seen[${name}]:-} ]] && break
			[[ $(ppa_version "${name}") == "${version}" ]] || continue
			seen[${name}]=1
			installed "${name}" || echo "${name}"
			break
		done
	done < <(used_locales)
	return 0
}

## Succeed if a home directory (see homes) is not accessible, as those of
##  other users without root (mode 750)
homes_hidden() {
	local entry
	while read -r entry; do
		[[ -x ${entry#*:} ]] || return 0
	done < <(homes)
	return 1
}

## moz_choice <package> <legacy snap profile> <XDG snap profile> <package profile> <name> <install hash> [<alternative>]
##  The snap profile directories are relative to $SNAP_USER_COMMON and
##  $SNAP_USER_DATA (see snap_profiles), the package profile directory to the
##  home directory. The install hash belongs to the package directory
##  (/usr/lib/<package>) in profiles.ini. Leave it empty if it is not known.
##  The alternative is the other package of the g-unity7-desktop relation,
##  mentioned if installed.
moz_choice() {
	local pkg=$1 legacy=$2 xdg=$3 deb_profile=$4 app=$5 hash=$6 alt=${7:-}
	local ppa status deb_installed= snap= snap_version= snap_rev= upstream users=() copy_users=()
	local copy_text options=() actions=() default=1 i answer entry user home src name
	local switch_id= adopt=adopt size free mount marker
	local -A shared=() copied=() sizes=() need=()
	ppa=$(ppa_version "${pkg}")
	[[ -n ${ppa} ]] || return 0
	if [[ -n ${spared[${pkg}]:-} ]]; then
		moz_lines+=( "${app}: unchanged (--keep ${pkg})" )
		return 0
	fi
	status=$(dpkg-query -W -f='${db:Status-Status} ${Version}' "${pkg}" 2>/dev/null) || true
	[[ ${status} == "installed "*+gu7* ]] && deb_installed=1
	## A package from another source, such as Mozilla's APT repository, stays
	##  as it is: it may be newer than the G Unity⁷ package, which then could not
	##  open its profile. The Ubuntu package that installs the snap has "snap" in
	##  its version (1:1snap1-0ubuntu11).
	if [[ ${status} == "installed "* && -z ${deb_installed} && ${status} != *snap* ]]; then
		moz_lines+=( "${app}: unchanged; ${pkg} ${status#installed } from another source is installed" )
		return 0
	fi
	snap_installed "${pkg}" && snap=1
	## Nothing to choose if the G Unity⁷ package is installed and the snap is not
	[[ -n ${snap} || -z ${deb_installed} ]] || return 0

	## A profile that a newer version used does not open in an older one
	if [[ -n ${snap} ]]; then
		read -r snap_version snap_rev < <(snap list "${pkg}" 2>/dev/null | awk 'NR == 2 { print $2, $3 }') || true
		upstream=${ppa#*:}
		upstream=${upstream%-*}
		if [[ -n ${snap_version} ]] && dpkg --compare-versions "${snap_version%-*}" gt "${upstream}"; then
			moz_lines+=( "${app}: unchanged; the snap ${snap_version} is newer than the G Unity⁷ package ${ppa}, which could not open its profile. Run g-unity7-cleanup again after the package is updated." )
			return 0
		fi
		## Do not touch a running snap: a copy of an open profile may be
		##  inconsistent, and a profile that the package creates in the meantime
		##  would stop the copy
		if snap_running "${pkg}"; then
			moz_lines+=( "${app}: the snap is running; close ${app} and run g-unity7-cleanup again" )
			return 0
		fi
		mapfile -t users < <(snap_profiles "${pkg}" "${legacy}" "${xdg}" "${snap_rev}")
		## An unfinished switch installed the package, which was not used yet
		[[ ! -f ${switch_dir}/switch-${pkg} ]] || switch_id=$(< "${switch_dir}/switch-${pkg}")
		[[ -z ${deb_installed} || -n ${switch_id} ]] || adopt=
		for entry in "${users[@]}"; do
			IFS=: read -r user home src <<< "${entry}"
			marker=${home}/${deb_profile}/${copy_marker}
			## The Thunderbird snap links its profile directory to
			##  ~/.thunderbird if that has profiles when the snap starts for
			##  the first time (Ubuntu's package before 24.04). The package
			##  then uses the same profiles, so there is nothing to copy.
			if [[ $(readlink -f -- "${src}") == "$(readlink -f -- "${home}/${deb_profile}")" ]]; then
				shared[${entry}]=1
			elif [[ -n ${switch_id} && -f ${marker} && ! -L ${marker} && $(< "${marker}") == "${switch_id} ${src}" \
				&& -z $(find "${src}/" -newer "${marker}" -print -quit 2>/dev/null) ]]; then
				copied[${entry}]=1
			else
				copy_users+=( "${user}" )
				size=$(du -sk -- "${src}/" 2>/dev/null | cut -f1) || size=
				sizes[${entry}]=${size:-0}
				read -r free mount < <(free_space "${home}/${deb_profile}") || true
				[[ -z ${mount} ]] || need[${mount}]=$(( ${need[${mount}]:-0} + ${size:-0} ))
			fi
		done
		if [[ ${EUID} -ne 0 && -z ${homes_noted} ]] && homes_hidden; then
			moz_lines+=( "Without root, the snap profiles of other users are not shown (sudo g-unity7-cleanup --dry-run shows them)" )
			homes_noted=1
		fi
		## Root cannot read some home directories, such as a network one
		if [[ ${EUID} -eq 0 ]]; then
			while read -r entry; do
				[[ -x ${entry#*:} ]] \
					|| moz_lines+=( "${app}: the home directory ${entry#*:} is not accessible; its snap profiles are not copied" )
			done < <(homes)
		fi
		## A copy must fit, with the copies already chosen
		for mount in "${!need[@]}"; do
			read -r free _ < <(free_space "${mount}") || true
			if [[ -n ${free} ]] && (( ${space_needed[${mount}]:-0} + need[${mount}] + space_spare > free )); then
				moz_lines+=( "${app}: unchanged; the copy of the snap profiles needs $(in_mb "${need[${mount}]}") in ${mount}, which has $(in_mb "${free}") free. Free some space and run g-unity7-cleanup again." )
				return 0
			fi
		done
	fi

	copy_text=
	if [[ ${#copy_users[@]} -gt 1 ]]; then
		copy_text="copy the snap profiles for $(and_list "${copy_users[@]}")"
	elif [[ ${#copy_users[@]} -eq 1 ]]; then
		copy_text="copy the snap profile for ${copy_users[0]}"
	fi
	if [[ -z ${snap} ]]; then
		options=( "Install the G Unity⁷ package (recommended)" "Do not install it" )
		actions=( deb nothing )
	elif [[ -n ${deb_installed} ]]; then
		if [[ -n ${copy_text} ]]; then
			options=( "${copy_text^} and remove the snap (recommended)" )
		else
			options=( "Remove the snap (recommended)" )
		fi
		options+=( "Keep the snap as well" )
		actions=( snap nothing )
	else
		options=( "Install the G Unity⁷ package${copy_text:+, ${copy_text}} and remove the snap (recommended)"
			"Keep the Ubuntu snap" )
		actions=( deb nothing )
	fi

	spinner_stop
	if [[ -z ${snap} ]]; then
		if [[ -n ${alt} ]] && installed "${alt}"; then
			echo "${alt^} is installed instead of ${app}."
		else
			echo "${app} is not installed."
		fi
		echo "G Unity⁷ provides a ${app} package with Unity's global menu:"
	elif [[ -n ${deb_installed} ]]; then
		echo "Both the G Unity⁷ ${app} package and the ${app} snap are installed:"
	else
		echo "${app} is installed as an Ubuntu snap."
		echo "G Unity⁷ provides a ${app} package with Unity's global menu:"
	fi
	if [[ -n ${yes} ]]; then
		answer=${default}
		echo "  ${options[answer - 1]}"
	else
		for i in "${!options[@]}"; do
			echo "  $(( i + 1 ))) ${options[i]}"
		done
		while :; do
			read -r -p "Choice [${default}]: " answer \
				|| die "no answer; use --yes to accept the recommended choices"
			answer=${answer:-${default}}
			[[ ${answer} =~ ^[1-9][0-9]*$ && ${answer} -le ${#actions[@]} ]] && break
			echo "Enter a number from 1 to ${#actions[@]}."
		done
	fi
	echo
	spinner_start

	case ${actions[answer - 1]} in
		nothing)
			if [[ -n ${snap} ]]; then
				moz_lines+=( "${app}: unchanged" )
			else
				moz_lines+=( "${app}: not installed" )
			fi
			return 0
			;;
		deb)
			moz_install+=( "${pkg}=${ppa}" )
			moz_lines+=( "${app}: install ${pkg} ${ppa} from G Unity⁷" )
			;;
	esac
	while read -r name; do
		moz_install+=( "${name}=${ppa}" )
		moz_lines+=( "${app}: install ${name} ${ppa} from G Unity⁷" )
	done < <(moz_l10n "${pkg}" "${ppa}")
	[[ -n ${snap} ]] || return 0
	for mount in "${!need[@]}"; do
		space_needed[${mount}]=$(( ${space_needed[${mount}]:-0} + need[${mount}] ))
	done
	## The snap's default profile becomes the default, unless the package was
	##  already installed and has its own default profile
	for entry in "${users[@]}"; do
		IFS=: read -r user home src <<< "${entry}"
		if [[ -n ${copied[${entry}]:-} ]]; then
			moz_lines+=( "${app}: ${src} was copied to ${home}/${deb_profile} before, nothing to copy" )
			continue
		fi
		moz_copy+=( "${user}:${src}:${home}/${deb_profile}:${hash}:${adopt}:${pkg}" )
		size=
		[[ -z ${sizes[${entry}]:-} ]] || size=" ($(in_mb "${sizes[${entry}]}"))"
		if [[ -n ${shared[${entry}]:-} && -z ${adopt} ]]; then
			moz_lines+=( "${app}: the snap uses ${home}/${deb_profile}, nothing to copy" )
		elif [[ -n ${shared[${entry}]:-} ]]; then
			moz_lines+=( "${app}: the snap uses ${home}/${deb_profile}, nothing to copy; make the snap's default profile the default" )
		elif [[ ! -f ${home}/${deb_profile}/profiles.ini ]]; then
			moz_lines+=( "${app}: copy ${src} to ${home}/${deb_profile}${size}" )
		elif [[ -z ${adopt} ]]; then
			moz_lines+=( "${app}: add the profiles in ${src} to ${home}/${deb_profile}${size}; the default profile stays" )
		else
			moz_lines+=( "${app}: add the profiles in ${src} to ${home}/${deb_profile}${size} and make the snap's default profile the default" )
		fi
	done
	moz_snap_remove+=( "${pkg}" )
	moz_lines+=( "${app}: remove the snap (snapd saves a snapshot of its data)" )
}

## The install hashes are CityHash64 (version 1.0.2) of the UTF-16 path of
##  /usr/lib/firefox and /usr/lib/thunderbird. The Firefox hash is the one that
##  the G Unity⁷ Firefox wrote.
moz_choice firefox .mozilla/firefox .config/mozilla/firefox .mozilla/firefox Firefox 4F96D1932A9F858E
moz_choice thunderbird .thunderbird .config/thunderbird .thunderbird Thunderbird FDC34C9F024745EB evolution

## Desktop files of snaps that are not installed. The Ubuntu image leaves those
##  of the snaps that the installer does not install, such as Thunderbird, and
##  the Dash shows them with a missing icon. snapd writes them only for
##  installed snaps. Nothing is removed if snap list fails.
snap_desktop_dir=/var/lib/snapd/desktop/applications
snap_desktop_remove=()
snaps_listed=
if command -v snap >/dev/null && snaps=$(LC_ALL=C snap list --all 2>/dev/null); then
	snaps_listed=1
	for file in "${snap_desktop_dir}"/*_*.desktop; do
		[[ -f ${file} ]] || continue
		## <snap>_<app>.desktop, or <snap>+<key>_<app>.desktop for an instance
		name=${file##*/}
		name=${name%%_*}
		name=${name/+/_}
		awk -v n="${name}" 'NR > 1 && $1 == n { found = 1 } END { exit !found }' <<< "${snaps}" \
			|| snap_desktop_remove+=( "${file}" )
	done
fi

## Mount units of snap revisions that are neither installed nor have their
##  .snap file. Some remain on Ubuntu Unity (old revisions of the base snaps,
##  Thunderbird), and they fail at every boot. Nothing is removed if snap list
##  fails.
snap_mount_remove=() snap_mount_lines=()
if [[ -n ${snaps_listed} ]]; then
	for file in /etc/systemd/system/snap-*.mount; do
		[[ -f ${file} ]] || continue
		what=$(awk -F= '$1 == "What" { print $2; exit }' "${file}")
		[[ ${what} == /var/lib/snapd/snaps/*_*.snap && ! -e ${what} ]] || continue
		## <snap>_<revision>.snap
		name=${what##*/}
		name=${name%.snap}
		rev=${name##*_}
		name=${name%_*}
		awk -v n="${name}" -v r="${rev}" 'NR > 1 && $1 == n && $3 == r { found = 1 } END { exit !found }' \
			<<< "${snaps}" && continue
		snap_mount_remove+=( "${file##*/}" )
		snap_mount_lines+=( "${name} ${rev} (${file##*/})" )
	done
fi

## Configuration files of packages that installing g-unity7-desktop removed
##  without purging them. The autostart file of PulseAudio, which PipeWire
##  replaces, starts a program that no longer exists.
conf_purge=()
for name in pulseaudio; do
	[[ $(dpkg-query -W -f='${db:Status-Status}' "${name}" 2>/dev/null) == config-files ]] \
		&& conf_purge+=( "${name}" )
done

mark=()
add_mark() {
	local name
	for name in "$@"; do
		[[ -n ${manual[${name}]:-} && -z ${keep[${name}]:-} && -z ${spared[${name}]:-} ]] \
			&& installed "${name}" || continue
		[[ -n ${in_list[${name}]:-} ]] || { mark+=( "${name}" ); in_list[${name}]=1; }
	done
}

## ubuntu-unity-desktop and the duplicates, on a system from the Ubuntu Unity
##  image. If ubuntu-unity-desktop is already removed, its relations come from
##  the archive.
duplicates=()
if [[ -n ${unity_image} ]]; then
	add_mark "${task}"
	mapfile -t duplicates < <(relations "${task}" "Depends Recommends" | tr ' ' '\n')
	add_mark "${duplicates[@]}"
fi

## Task packages that the installed duplicates and the removed alternatives
##  depend on or recommend, except those of packages kept by a choice.
roots=( "${candidates_remove[@]}" )
for name in "${duplicates[@]}"; do
	[[ -z ${spared[${name}]:-} ]] && installed "${name}" && roots+=( "${name}" )
done
if [[ ${#roots[@]} -gt 0 ]]; then
	mapfile -t closure < <(apt-cache depends --recurse --installed --no-suggests --no-conflicts \
		--no-breaks --no-replaces --no-enhances "${roots[@]}" 2>/dev/null \
		| grep -v '^[ <]' | sort -u || true)
	candidates=()
	for name in "${closure[@]}"; do
		[[ -n ${manual[${name}]:-} && -z ${keep[${name}]:-} && -z ${spared[${name}]:-} ]] \
			&& candidates+=( "${name}" )
	done
	mapfile -t closure_of_task < <(of_task "${candidates[@]}")
	add_mark "${closure_of_task[@]}"
fi

