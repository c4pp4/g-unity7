# Global menu of the GTK applications in the Unity session (appmenu-gtk-module),
# as the xinitrc.d script of x11-misc/appmenu-gtk-module in Gentoo. The systemd
# user unit of appmenu-gtk-module-common is not started in the Unity session
# and sets GTK_MODULES only for the activated services, the applications started
# by other applications (system-config-printer from unity-control-center)
# inherit the environment of the session.

case :$XDG_CURRENT_DESKTOP: in
	*:Unity:*)
		case :$GTK_MODULES: in
			*:appmenu-gtk-module:*)
				;;
			*)
				GTK_MODULES=${GTK_MODULES}${GTK_MODULES:+:}appmenu-gtk-module
		esac

		if [ -z "$UBUNTU_MENUPROXY" ]; then
			UBUNTU_MENUPROXY=1
		fi

		export GTK_MODULES
		export UBUNTU_MENUPROXY
		;;
esac
