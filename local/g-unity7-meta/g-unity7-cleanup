[[ -z ${unity_image} ]] || add_mark "${leftovers[@]}"

## Apply the marks to a copy of the apt state and find what autoremove then
##  removes.
tmp=$(mktemp -d)
states=${tmp}/extended_states
cp /var/lib/apt/extended_states "${states}" 2>/dev/null || : > "${states}"
[[ ${#mark[@]} -eq 0 ]] || apt-mark -o Dir::State::extended_states="${states}" auto "${mark[@]}" >/dev/null
## Packages given with --keep that are automatically installed become manually
##  installed, so that autoremove keeps them
keep_manual=()
if [[ ${#keep_given[@]} -gt 0 ]]; then
	while read -r name; do
		if installed "${name}" && [[ -z ${manual[${name}]:-} ]]; then
			keep_manual+=( "${name}" )
		fi
	done < <(printf '%s\n' "${!keep_given[@]}" | sort)
fi
[[ ${#keep_manual[@]} -eq 0 ]] \
	|| apt-mark -o Dir::State::extended_states="${states}" manual "${keep_manual[@]}" >/dev/null
declare -A autoremoved=()
while read -r name; do
	autoremoved[${name}]=1
done < <(apt-get -s -o Dir::State::extended_states="${states}" --purge autoremove 2>/dev/null \
	| awk '/^Purg / { print $2 }')

install_args=( "${install[@]/%/+}" )

## Print the packages other than $1 that apt removes with it, except those that
##  autoremove removes anyway, such as ubuntu-unity-desktop, separated by spaces.
removed_with() {
	local other others=
	while read -r other; do
		[[ ${other} == "$1" || -n ${autoremoved[${other}]:-} ]] || others+="${other} "
	done < <(apt-get -s -o Dir::State::extended_states="${states}" --purge remove "$1" \
		"${install_args[@]}" 2>/dev/null | awk '/^(Purg|Remv) / { print $2 }')
	echo "${others% }"
}

## The alternatives to remove, except those that other packages need.
remove=() reasons=() needed_kept=()
for name in "${candidates_remove[@]}"; do
	others=$(removed_with "${name}")
	if [[ -n ${others} ]]; then
		needed_kept+=( "${name} (needed by ${others})" )
		continue
	fi
	remove+=( "${name}" )
	reasons+=( "${name} (${reason[${name}]})" )
done

## Duplicates that autoremove keeps as an installed alternative of another
##  relation, such as lightdm-gtk-greeter for lightdm-greeter or xfwm4 for
##  x-window-manager. They are removed if no other package would be removed
##  with them. Alternatives of g-unity7-desktop are left to the choices above.
declare -A of_meta=() in_remove=()
while read -r name; do
	of_meta[${name}]=1
done < <(relations "${meta}" "Depends Recommends Suggests" | tr ' ' '\n')
dup_remove=()
for name in "${duplicates[@]}"; do
	[[ -z ${of_meta[${name}]:-} && -z ${spared[${name}]:-} && -z ${autoremoved[${name}]:-} \
		&& -z ${in_remove[${name}]:-} ]] && installed "${name}" || continue
	in_remove[${name}]=1
	[[ -z $(removed_with "${name}") ]] || continue
	remove+=( "${name}" )
	dup_remove+=( "${name}" )
done

## Packages of the image that apt keeps only as an installed alternative of
##  another relation: kdialog of "zenity | kdialog" (im-config). It pulls in the
##  KIO of KDE Frameworks 6, which suggests systemsettings. It is automatically
##  installed, so marking does not remove it. On a system from the Ubuntu Unity
##  image, it is removed if no other package would be removed with it.
leftover_remove=()
for name in kdialog; do
	[[ -n ${unity_image} && -z ${of_meta[${name}]:-} && -z ${spared[${name}]:-} \
		&& -z ${autoremoved[${name}]:-} && -z ${in_remove[${name}]:-} ]] && installed "${name}" || continue
	in_remove[${name}]=1
	[[ -z $(removed_with "${name}") ]] || continue
	remove+=( "${name}" )
	leftover_remove+=( "${name}" )
done

## Preview the result with the marks applied to a copy of the apt state.
if [[ ${#remove[@]} -gt 0 || ${#install[@]} -gt 0 ]]; then
	apt_args=( --purge --autoremove remove "${remove[@]}" "${install_args[@]}" )
else
	apt_args=( --purge autoremove )
fi
simulation=$(apt-get -s -o Dir::State::extended_states="${states}" "${apt_args[@]}" 2>&1) \
	|| die "apt cannot make these changes:"$'\n'"${simulation}"
mapfile -t removed < <(awk '/^Purg / { print $2 }' <<< "${simulation}")

## Add the packages that the apt simulation $1 installs, upgrades or
##  downgrades to installs, upgrades or downgrades, each package once.
## "Inst <package> [<installed version>] (<new version> <release> [<arch>])"
installs=() upgrades=() downgrades=()
declare -A listed=()
read_installs() {
	local name old new
	while read -r name old new; do
		[[ -z ${listed[${name}]:-} ]] || continue
		listed[${name}]=1
		if [[ ${old} == - ]]; then
			installs+=( "${name}" )
		elif dpkg --compare-versions "${new}" gt "${old}"; then
			upgrades+=( "${name}" )
		else
			downgrades+=( "${name}" )
		fi
	done < <(awk '/^Inst / {
		old = "-"; new = $3
		if ($3 ~ /^\[/) { old = $3; new = $4 }
		gsub(/[][]/, "", old); gsub(/[()]/, "", new)
		print $2, old, new }' <<< "$1")
}
read_installs "${simulation}"
## apt-get -y refuses to downgrade packages unless it is allowed. The list
##  below shows them before the confirmation.
main_downgrades=${#downgrades[@]}

## Keep only the marked packages that apt then removes. The others are still
##  needed by G Unity⁷ or by another desktop (ubuntu-desktop shares most of the
##  task), so marking them would only change their state. apt removes the same
##  packages without them, because a kept package and its dependencies are
##  still needed.
declare -A removed_set=()
for name in "${removed[@]}"; do
	removed_set[${name}]=1
done
## Packages that are removed directly are not marked.
for name in "${remove[@]}"; do
	removed_set[${name}]=
done
marked=()
for name in "${mark[@]}"; do
	[[ -z ${removed_set[${name}]:-} ]] || marked+=( "${name}" )
done
mark=( "${marked[@]}" )

## The G Unity⁷ Firefox and Thunderbird packages are installed after the
##  changes above, as a downgrade of the Ubuntu packages. Their simulation on
##  the current state adds what apt installs and removes with them.
moz_removed=()
if [[ ${#moz_install[@]} -gt 0 ]]; then
	simulation=$(apt-get -s -o Dir::State::extended_states="${states}" --allow-downgrades \
		install "${moz_install[@]}" 2>&1) \
		|| die "apt cannot install $(and_list "${moz_install[@]%%=*}"):"$'\n'"${simulation}"
	read_installs "${simulation}"
	mapfile -t moz_removed < <(awk '/^(Remv|Purg) / { print $2 }' <<< "${simulation}")
fi

## Print what apt does with the marks applied to a new copy ($1) of the apt
##  state: the changes above and the G Unity⁷ Firefox and Thunderbird
##  packages, sorted
plan_of() {
	cp /var/lib/apt/extended_states "$1" 2>/dev/null || : > "$1"
	[[ ${#mark[@]} -eq 0 ]] || apt-mark -o Dir::State::extended_states="$1" auto "${mark[@]}" >/dev/null || true
	[[ ${#keep_manual[@]} -eq 0 ]] \
		|| apt-mark -o Dir::State::extended_states="$1" manual "${keep_manual[@]}" >/dev/null || true
	{
		if [[ ${#mark[@]} -gt 0 || ${#remove[@]} -gt 0 || ${#install[@]} -gt 0 ]]; then
			apt-get -s -o Dir::State::extended_states="$1" "${apt_args[@]}" 2>&1 || true
		fi
		if [[ ${#moz_install[@]} -gt 0 ]]; then
			apt-get -s -o Dir::State::extended_states="$1" --allow-downgrades install "${moz_install[@]}" 2>&1 || true
		fi
	} | awk '/^(Inst|Remv|Purg) / { print $1, $2 }' | sort
}
plan=
[[ -n ${dry_run} ]] || plan=$(plan_of "${tmp}"/extended_states.plan)

if [[ ${#mark[@]} -eq 0 && ${#remove[@]} -eq 0 && ${#install[@]} -eq 0 \
	&& ${#moz_install[@]} -eq 0 && ${#moz_snap_remove[@]} -eq 0 \
	&& ${#snap_desktop_remove[@]} -eq 0 && ${#snap_mount_remove[@]} -eq 0 \
	&& ${#conf_purge[@]} -eq 0 ]]; then
	spinner_stop
	echo "Nothing to do. No Ubuntu Unity packages replaced by G Unity⁷ are left."
	[[ ${#unchanged[@]} -eq 0 ]] || printf 'Left unchanged by your choice: %s\n' "${unchanged[@]}"
	[[ ${#needed_kept[@]} -eq 0 ]] || printf 'Kept because other packages need it: %s\n' "${needed_kept[@]}"
	[[ ${#moz_lines[@]} -eq 0 ]] || printf '%s\n' "${moz_lines[@]}"
	exit 0
fi

spinner_stop

## Print a list of packages side by side as apt does, or one item per line.
list_words() {
	local title=$1 width
	shift
	[[ $# -gt 0 ]] || return 0
	width=$(tput cols 2>/dev/null) || width=80
	echo "${title} ($#):"
	printf '%s\n' "$@" | awk -v width="${width}" '
		length(line) && length(line) + 1 + length($0) > width { print line; line = "" }
		{ line = length(line) ? line " " $0 : "  " $0 }
		END { if (length(line)) print line }'
	echo
}

list_lines() {
	local title=$1
	shift
	[[ $# -gt 0 ]] || return 0
	echo "${title} ($#):"
	printf '  %s\n' "$@"
	echo
}

list_words "Alternatives to install" "${install[@]}"
list_lines "Alternatives to remove" "${reasons[@]}"
## The duplicates and image packages that are removed directly, and the
##  packages that are marked for autoremove
list_words "Replaced by G Unity⁷ or not used by it, to be removed" \
	"${dup_remove[@]}" "${leftover_remove[@]}" "${mark[@]}"
list_lines "Left unchanged by your choice" "${unchanged[@]}"
list_lines "Alternatives kept because other packages need them" "${needed_kept[@]}"
list_lines "Firefox and Thunderbird" "${moz_lines[@]}"
list_lines "Desktop files of snaps that are not installed, to be removed" "${snap_desktop_remove[@]}"
list_lines "Mount units of snap revisions that are not installed, to be removed" "${snap_mount_lines[@]}"
list_words "Configuration files of removed packages, to be purged" "${conf_purge[@]}"
list_words "Kept with --keep and marked as manually installed" "${keep_manual[@]}"
list_words "Packages apt will install" "${installs[@]}"
list_words "Packages apt will upgrade" "${upgrades[@]}"
list_words "Packages apt will downgrade" "${downgrades[@]}"
## Purged with their configuration files and marked with * as apt does
if [[ ${#removed[@]} -gt 0 || ${#moz_removed[@]} -gt 0 ]]; then
	list_words "Packages apt will remove" "${removed[@]/%/*}" "${moz_removed[@]}"
else
	echo "Packages apt will remove: none"
	echo
fi
echo "To keep a package, run: sudo g-unity7-cleanup --keep <package>"

[[ -z ${dry_run} ]] || exit 0

if [[ -z ${yes} ]]; then
	read -r -p "Do you want to continue? [y/N] " answer || answer=
	[[ ${answer} == [yY]* ]] || { echo "No changes were made."; exit 0; }
fi

[[ ${#moz_copy[@]} -eq 0 || -x ${copy_profiles} ]] \
	|| die "${copy_profiles} is missing; reinstall g-unity7-desktop"
## apt-mark does not wait for another apt, which would write back its own marks
##  when it finishes. apt-get check waits until it has finished.
apt-get -qq "${apt_lock[@]}" check
## That apt, such as unattended-upgrades, may have changed the package lists or
##  the marks since the preview
[[ $(plan_of "${tmp}"/extended_states.now) == "${plan}" ]] \
	|| die "apt would now make other changes than shown, as another apt changed the package lists or marks in the meantime; no changes were made; run g-unity7-cleanup again"
## Later runs remember that the system comes from the Ubuntu Unity image
if [[ -n ${unity_image} && ! -e ${unity_marker} ]]; then
	mkdir -p "${unity_marker%/*}"
	touch "${unity_marker}"
fi
[[ ${#keep_manual[@]} -eq 0 ]] || apt-mark manual "${keep_manual[@]}" >/dev/null
[[ ${#mark[@]} -eq 0 ]] || apt-mark auto "${mark[@]}" >/dev/null
if [[ ${#mark[@]} -gt 0 || ${#remove[@]} -gt 0 || ${#install[@]} -gt 0 ]]; then
	if [[ ${main_downgrades} -gt 0 ]]; then
		apt-get -y "${apt_lock[@]}" --allow-downgrades "${apt_args[@]}"
	else
		apt-get -y "${apt_lock[@]}" "${apt_args[@]}"
	fi
fi
## Installed first alternatives are needed only by g-unity7-desktop. Other
##  alternatives were chosen by the user and stay manual, like a package in
##  @world.
install_auto=()
for name in "${install[@]}"; do
	[[ -z ${keep[${name}]:-} ]] || install_auto+=( "${name}" )
done
[[ ${#install_auto[@]} -eq 0 ]] || apt-mark auto "${install_auto[@]}" >/dev/null

if [[ ${#snap_desktop_remove[@]} -gt 0 ]]; then
	rm -f "${snap_desktop_remove[@]}"
	! command -v update-desktop-database >/dev/null \
		|| update-desktop-database "${snap_desktop_dir}" || true
fi
if [[ ${#snap_mount_remove[@]} -gt 0 ]]; then
	systemctl disable --no-reload "${snap_mount_remove[@]}" 2>/dev/null || true
	for unit in "${snap_mount_remove[@]}"; do
		rm -f /etc/systemd/system/"${unit}" /etc/systemd/system/*.wants/"${unit}"
	done
	systemctl daemon-reload
	systemctl reset-failed "${snap_mount_remove[@]}" 2>/dev/null || true
fi
[[ ${#conf_purge[@]} -eq 0 ]] || apt-get -y -qq "${apt_lock[@]}" purge "${conf_purge[@]}" >/dev/null
## The G Unity⁷ Firefox and Thunderbird packages (a lower version than the
##  Ubuntu packages; their pin comes with them), then the snap profiles and the
##  snaps.
## The switch from each snap starts before its package is installed (see
##  switch_dir). The file of a snap that this run does not remove is from a
##  switch that was given up.
for file in "${switch_dir}"/switch-*; do
	[[ -e ${file} ]] || continue
	[[ " ${moz_snap_remove[*]} " == *" ${file##*/switch-} "* ]] || rm -f -- "${file}"
done
for name in "${moz_snap_remove[@]}"; do
	[[ ! -s ${switch_dir}/switch-${name} ]] || continue
	mkdir -p "${switch_dir}"
	printf '%s-%s\n' "$(date -u +%Y%m%dT%H%M%SZ)" "$$" > "${switch_dir}/switch-${name}"
done
if [[ ${#moz_install[@]} -gt 0 ]]; then
	apt-get -y "${apt_lock[@]}" --allow-downgrades install "${moz_install[@]}"
fi
## The users own their home directories and can replace any path in them with
##  a link, so the profiles of each user are copied as that user (setpriv is
##  part of util-linux, which is essential).
## A snap that was started after the analysis keeps its profiles and stays
##  installed: a copy of an open profile may be inconsistent.
cd /
declare -A moz_running=()
for name in "${moz_snap_remove[@]}"; do
	if snap_running "${name}"; then
		moz_running[${name}]=1
	fi
done
## A copy that fails keeps its snap installed, and the copies of the other
##  users are still made; the next run does not make them again.
declare -A moz_copy_failed=()
for entry in "${moz_copy[@]}"; do
	IFS=: read -r user src dst hash adopt name <<< "${entry}"
	[[ -z ${moz_running[${name}]:-} ]] || continue
	if ! setpriv --reuid="${user}" --regid="$(id -g "${user}")" --init-groups --reset-env \
		"${copy_profiles}" "${src}" "${dst}" "${hash}" "${adopt}" "$(< "${switch_dir}/switch-${name}")"; then
		echo "g-unity7-cleanup: cannot copy the ${name} profiles of ${user}" >&2
		moz_copy_failed[${name}]=1
	fi
done
moz_failed=() moz_left=()
for name in "${moz_snap_remove[@]}"; do
	if [[ -n ${moz_copy_failed[${name}]:-} ]]; then
		echo "g-unity7-cleanup: the ${name} snap stays installed, because a copy of its profiles failed; fix the error, such as a full disk, and run g-unity7-cleanup again" >&2
		moz_left+=( "${name}" )
		continue
	fi
	if [[ -n ${moz_running[${name}]:-} ]]; then
		echo "g-unity7-cleanup: the ${name} snap was started; close it and run g-unity7-cleanup again" >&2
		moz_left+=( "${name}" )
		continue
	fi
	## Copying a large profile takes a while
	if snap_running "${name}"; then
		echo "g-unity7-cleanup: the ${name} snap was started after its profiles were copied; close it and remove it with: sudo snap remove ${name}" >&2
		moz_left+=( "${name}" )
		continue
	fi
	snap_orphans_remove "${name}"
	if snap remove "${name}"; then
		rm -f -- "${switch_dir}/switch-${name}"
	else
		moz_failed+=( "${name}" )
	fi
done
if [[ ${#moz_failed[@]} -gt 1 ]]; then
	echo "g-unity7-cleanup: cannot remove the $(and_list "${moz_failed[@]}") snaps; the profiles have been copied" >&2
elif [[ ${#moz_failed[@]} -eq 1 ]]; then
	echo "g-unity7-cleanup: cannot remove the ${moz_failed[0]} snap; the profiles have been copied" >&2
fi
[[ ${#moz_failed[@]} -eq 0 ]] || echo "Remove the snap with: sudo snap remove ${moz_failed[*]}" >&2
[[ ${#moz_failed[@]} -eq 0 && ${#moz_left[@]} -eq 0 ]] || exit 1
