#!/bin/bash
## Copy the profiles of a Firefox or Thunderbird snap to the profile directory
##  of the G Unity⁷ package. g-unity7-cleanup runs it as the user whose
##  profiles they are: the user owns these directories and can replace any path
##  in them with a link, so the copy must not have more rights than the user.
##
## Usage: copy-snap-profiles <snap profile directory> <package profile directory>
##          <install hash> <adopt> [<switch id>]
##
##  If the package profile directory has no profiles.ini, the snap profiles are
##  copied as they are, and the snap's default profile becomes the default
##  profile of the package. Otherwise each snap profile is added to it, with
##  "(snap)" after its name, and no profile is replaced; the snap's default
##  profile becomes the default profile of the package only if <adopt> is
##  "adopt". A directory without profiles.ini that already has a file or
##  directory of the snap profile directory, such as a profile left behind, is
##  given an empty profiles.ini, and the snap profiles are added to it. If the
##  snap profile directory is the package profile directory (a link), nothing
##  is copied, and the snap's default profile becomes the default profile of
##  the package with <adopt>. The install hash belongs to the package directory
##  (/usr/lib/firefox) in profiles.ini and installs.ini; if it is empty, the
##  default profile does not change.
##
##  Each copy goes to a temporary directory next to the package profile
##  directory first and is moved into place when it is complete, so that an
##  error, such as a full disk, leaves no part of a profile behind. With
##  <switch id> (g-unity7-cleanup gives one for each switch from a snap to the
##  package), a copy that was completed in the same switch is not made again,
##  such as when the copy of another user stopped the run, unless the snap
##  changed the profiles since then.

set -euo pipefail
umask 077

die() {
	echo "copy-snap-profiles: $*" >&2
	exit 1
}

[[ ${EUID} -ne 0 ]] || die "run it as the user whose profiles they are, not as root"
[[ $# -eq 4 || $# -eq 5 ]] \
	|| die "usage: copy-snap-profiles <snap profile directory> <package profile directory> <install hash> <adopt> [<switch id>]"
src=$1 dst=$2 hash=$3 adopt=$4 switch=${5:-}
[[ -f ${src}/profiles.ini ]] || die "cannot read ${src}/profiles.ini"
## Written to the package profile directory when the copy of a switch is done
marker=.g-unity7-snap-copy

## The temporary directory of the copies, removed on exit
tmp=
trap '[[ -z ${tmp} ]] || rm -rf -- "${tmp}"' EXIT

## Create the temporary directory in directory $1, on the file system of the
##  package profile directory, so that a complete copy is only renamed.
make_tmp() {
	tmp=$(mktemp -d "$1/.g-unity7-copy.XXXXXX" 2>/dev/null) || die "cannot create a temporary directory in $1"
}

## Record that the copy of this switch is done
mark_done() {
	[[ -z ${switch} ]] || printf '%s %s\n' "${switch}" "${src}" > "${dst}/${marker}" \
		|| die "cannot write ${dst}/${marker}"
}

## Print the path of the default profile of the snap in profiles.ini $1: the
##  profile with Default=1, or else the only profile. In a snap, Firefox and
##  Thunderbird do not keep a profile for each install (nsToolkitProfileService),
##  so they open this profile and ignore the install sections. Those in a snap
##  profile directory come from Ubuntu's package before the snap and may name an
##  older profile.
moz_default_profile() {
	awk -F= '
		/^\[/ { section = $0; next }
		section ~ /^\[Profile[0-9]+\]$/ && $1 == "Path" { path[section] = $2; only = $2; n++ }
		section ~ /^\[Profile[0-9]+\]$/ && $1 == "Default" && $2 == "1" { def = section }
		END { if (def != "") print path[def]; else if (n == 1) print only }
	' "$1" 2>/dev/null || true
}

## Set Default=$3 in section [$2] of ini file $1, or add the section.
ini_set_default() {
	local file=$1 section=$2 value=$3 content
	if [[ -f ${file} ]] && grep -qxF "[${section}]" "${file}"; then
		content=$(awk -v s="[${section}]" -v v="${value}" '
			/^\[/ { in_s = ($0 == s); print; if (in_s) print "Default=" v; next }
			in_s && /^Default=/ { next }
			{ print }' "${file}") || die "cannot read ${file}"
		printf '%s\n' "${content}" > "${file}" || die "cannot write ${file}"
	else
		printf '\n[%s]\nDefault=%s\nLocked=1\n' "${section}" "${value}" >> "${file}" \
			|| die "cannot write ${file}"
	fi
}

## Make profile $3 (a path relative to the profile directory $1) the profile of
##  the package, as Firefox does on its first run. $2 is the install hash of
##  the package directory in profiles.ini and installs.ini. Without this,
##  Firefox creates a new profile, because the compatibility.ini of a copied
##  profile points to the snap.
moz_claim_profile() {
	local dir=$1 hash=$2 profile=$3
	[[ -n ${hash} && -n ${profile} ]] || return 0
	ini_set_default "${dir}/profiles.ini" "Install${hash}" "${profile}"
	ini_set_default "${dir}/installs.ini" "${hash}" "${profile}"
	echo "Set ${dir}/${profile} as the default profile"
}

## Add the profiles in the snap profile directory $1 to the profile directory
##  $2, which has its own profiles.ini: copy each profile directory (with
##  "-snap" added if the name is taken; the snap copied the old profiles of the
##  Ubuntu package under the same names) and add it to profiles.ini with
##  "(snap)" after its name. No profile is replaced. With $4, the snap's
##  default profile becomes the default profile of the package (install hash
##  $3); otherwise the default stays. Only profiles in a directory of their own
##  in the snap profile directory are copied, as Firefox and Thunderbird create
##  them, not those with an absolute path or a path with "/". All profiles are
##  copied to the temporary directory before the first one is moved into
##  place, so that an error leaves the package profile directory as it was.
moz_merge_profiles() {
	local src=$1 dst=$2 hash=$3 adopt=$4
	local def def_new='' n name path rel new i entry entries=()
	def=$(moz_default_profile "${src}/profiles.ini")
	n=$(sed -n 's/^\[Profile\([0-9]*\)\]$/\1/p' "${dst}/profiles.ini" | sort -n | tail -n 1) || true
	n=$(( ${n:--1} + 1 ))
	make_tmp "${dst}"
	## Fields separated by \x1f, which keeps an empty name as a field
	while IFS=$'\x1f' read -r name path rel; do
		[[ ${rel} == 1 && -n ${path} && ${path} != */* && ${path} != . && ${path} != .. \
			&& -d ${src}/${path} ]] || continue
		new=${path}
		[[ ! -e ${dst}/${new} && ! -e ${tmp}/${new} ]] || new=${path}-snap
		i=2
		while [[ -e ${dst}/${new} || -e ${tmp}/${new} ]]; do
			new=${path}-snap${i}
			i=$(( i + 1 ))
		done
		cp -a "${src}/${path}" "${tmp}/${new}" || die "cannot copy ${src}/${path}"
		entries+=( "${name}"$'\x1f'"${path}"$'\x1f'"${new}" )
	done < <(awk '
		function out() { if (sec ~ /^\[Profile[0-9]+\]$/ && path != "") printf "%s\037%s\037%s\n", name, path, rel }
		/^\[/ { out(); sec = $0; name = path = rel = ""; next }
		{ k = $0; sub(/=.*/, "", k); v = $0; sub(/^[^=]*=/, "", v) }
		k == "Name" { name = v }
		k == "Path" { path = v }
		k == "IsRelative" { rel = v }
		END { out() }' "${src}/profiles.ini")
	for entry in "${entries[@]}"; do
		IFS=$'\x1f' read -r name path new <<< "${entry}"
		mv -T -- "${tmp}/${new}" "${dst}/${new}" || die "cannot move the copy of ${src}/${path} to ${dst}/${new}"
		printf '\n[Profile%s]\nName=%s (snap)\nIsRelative=1\nPath=%s\n' "${n}" "${name}" "${new}" \
			>> "${dst}/profiles.ini" || die "cannot write ${dst}/profiles.ini"
		echo "Copied ${src}/${path} to ${dst}/${new}"
		n=$(( n + 1 ))
		[[ ${path} != "${def}" ]] || def_new=${new}
	done
	[[ -z ${adopt} ]] || moz_claim_profile "${dst}" "${hash}" "${def_new}"
}

[[ ${adopt} == adopt ]] || adopt=
## A copy of this switch is not made again, unless the snap changed the
##  profiles since then
if [[ -n ${switch} && -f ${dst}/${marker} && ! -L ${dst}/${marker} \
	&& $(< "${dst}/${marker}") == "${switch} ${src}" \
	&& -z $(find "${src}/" -newer "${dst}/${marker}" -print -quit 2>/dev/null) ]]; then
	echo "${src} was copied to ${dst} before, nothing to copy"
	exit 0
fi
## The Thunderbird snap links its profile directory to ~/.thunderbird if that
##  has profiles when the snap starts for the first time (Ubuntu's package
##  before 24.04). The package then uses the same profiles.
if [[ -d ${dst} && $(readlink -f -- "${src}") == "$(readlink -f -- "${dst}")" ]]; then
	echo "${src} is ${dst}, nothing to copy"
	[[ -z ${adopt} ]] || moz_claim_profile "${dst}" "${hash}" "$(moz_default_profile "${dst}/profiles.ini")"
	exit 0
fi
if [[ -f ${dst}/profiles.ini ]]; then
	moz_merge_profiles "${src}" "${dst}" "${hash}" "${adopt}"
	mark_done
	exit 0
fi
if [[ -d ${dst} ]]; then
	## Copied into the directory as they are only if no name is taken
	for path in "${src}"/* "${src}"/.[!.]* "${src}"/..?*; do
		[[ -e ${path} || -L ${path} ]] || continue
		if [[ -e ${dst}/${path##*/} || -L ${dst}/${path##*/} ]]; then
			printf '[General]\nStartWithLastProfile=1\nVersion=2\n' > "${dst}/profiles.ini" \
				|| die "cannot write ${dst}/profiles.ini"
			moz_merge_profiles "${src}" "${dst}" "${hash}" adopt
			mark_done
			exit 0
		fi
	done
	make_tmp "${dst}"
	cp -a "${src}/." "${tmp}/" || die "cannot copy ${src}"
	## profiles.ini last: without it, the directory is not a profile directory
	for path in "${tmp}"/* "${tmp}"/.[!.]* "${tmp}"/..?*; do
		[[ -e ${path} || -L ${path} ]] || continue
		[[ ${path##*/} != profiles.ini ]] || continue
		mv -T -- "${path}" "${dst}/${path##*/}" || die "cannot move the copy of ${src}/${path##*/} to ${dst}"
	done
	mv -T -- "${tmp}/profiles.ini" "${dst}/profiles.ini" || die "cannot move the copy of ${src}/profiles.ini to ${dst}"
else
	mkdir -p "$(dirname "${dst}")" || die "cannot create $(dirname "${dst}")"
	make_tmp "$(dirname "${dst}")"
	cp -a "${src}" "${tmp}/copy" || die "cannot copy ${src}"
	## Private, as Firefox and Thunderbird create it. cp keeps the mode of the
	##  snap directory, which other users can read.
	chmod go-rwx "${tmp}/copy" || die "cannot change the mode of the copy of ${src}"
	mv -T -- "${tmp}/copy" "${dst}" || die "cannot move the copy of ${src} to ${dst}"
fi
echo "Copied ${src} to ${dst}"
moz_claim_profile "${dst}" "${hash}" "$(moz_default_profile "${dst}/profiles.ini")"
mark_done
