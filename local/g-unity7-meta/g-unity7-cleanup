#!/bin/bash
## Remove the packages of Ubuntu Unity that G Unity⁷ replaces, like
##  "emerge --depclean" of Gentoo.
##
## The installer of Ubuntu Unity installs the ubuntu-unity-desktop task and apt
##  marks its packages as manually installed, autoremove never removes them.
##  apt also keeps every installed alternative of a relation ("vlc | showtime"),
##  Portage keeps only one. The script:
##  - asks which package to keep of each relation of the Depends and Recommends
##    of g-unity7-desktop with more installed alternatives or with another
##    alternative installed instead of the first one (apt does not install
##    eog of "eog | eom | loupe" if eom is installed): the first one
##    (recommended) or another one, installed if it is not, or all of them;
##    the other ones are removed, an alternative is kept if other packages
##    would have to be removed with it
##  - marks as automatically installed, if manually installed and not kept by
##    a choice:
##    - ubuntu-unity-desktop
##    - the packages ubuntu-unity-desktop depends on or recommends and
##      g-unity7-desktop does not depend on, recommend or suggest as the first
##      alternative (the duplicates)
##    - the packages of the task the duplicates and the alternatives to remove
##      depend on or recommend (file-roller of nemo-fileroller)
##    only those autoremove removes then (the others stay needed, e.g. by
##    another desktop as ubuntu-desktop)
##  - removes the duplicates apt keeps as an installed alternative of another
##    relation (lightdm-gtk-greeter, xfwm4), if nothing else is removed with them
##  - removes the packages autoremove removes then
##  - asks whether to install Firefox and Thunderbird of the PPA (with the
##    global menu) instead of the snaps of Ubuntu, copies the profiles of the
##    snaps to the users without a profile of the deb, then removes the snaps

set -euo pipefail

meta=g-unity7-desktop
task=ubuntu-unity-desktop

usage() {
	cat <<-EOF
		Usage: g-unity7-cleanup [-n|--dry-run] [-y|--yes]

		Remove the packages of Ubuntu Unity that G Unity⁷ replaces: the duplicate
		applications and the other installed alternatives of the applications of
		g-unity7-desktop, as "emerge --depclean" of Gentoo. Of more installed
		alternatives, or of another alternative installed instead of the
		recommended one, it asks which one to keep.

		  -n, --dry-run  only show the packages, change nothing (no root needed)
		  -y, --yes      do not ask, keep or install the recommended alternatives
	EOF
}

dry_run=
yes=
while [[ $# -gt 0 ]]; do
	case $1 in
		-n|--dry-run) dry_run=1 ;;
		-y|--yes) yes=1 ;;
		-h|--help) usage; exit 0 ;;
		*) usage >&2; exit 2 ;;
	esac
	shift
done

## The progress spinner (on a terminal only), as in version_control.sh of the
##  overlay; the block runs in a subshell.
spinner=( "|" "/" "-" "\\" )
spinner_pid=

spinner_start() {
	[[ -t 2 && -z ${spinner_pid} ]] || return 0
	{
		pos=1
		printf "%s %s" "Looking for packages" "${spinner[0]}"
		while sleep 0.1; do
			printf "\b%s" "${spinner[pos]}"
			pos=$(( (pos + 1) % ${#spinner[@]} ))
		done
	} >&2 &
	spinner_pid=$!
}

spinner_stop() {
	[[ -n ${spinner_pid} ]] || return 0
	kill "${spinner_pid}" 2>/dev/null || true
	wait "${spinner_pid}" 2>/dev/null || true
	spinner_pid=
	printf "\r%22s\r" "" >&2
}

tmp=
trap 'spinner_stop; [[ -z ${tmp} ]] || rm -rf "${tmp}"' EXIT

die() {
	spinner_stop
	echo "g-unity7-cleanup: $*" >&2
	exit 1
}

[[ -n ${dry_run} || ${EUID} -eq 0 ]] || die "run it as root (sudo g-unity7-cleanup) or with --dry-run"

installed() {
	[[ $(dpkg-query -W -f='${db:Status-Status}' "$1" 2>/dev/null) == installed ]]
}

installed "${meta}" || die "${meta} is not installed"
spinner_start

## The relations of the fields $2 of a package ($1, the installed version or the
##  candidate of the archive), one per line, the alternatives separated by spaces.
relations() {
	apt-cache show --no-all-versions "$1" 2>/dev/null \
		| awk -v fields="$2" '
			BEGIN { n = split(fields, f, " "); for (i = 1; i <= n; i++) want[f[i] ":"] = 1 }
			/^[^ ]/ { take = ($1 in want) }
			take { sub(/^[^ ]+: /, ""); print }' \
		| tr ',' '\n' \
		| sed -e 's/([^)]*)//g' -e 's/\[[^]]*\]//g' -e 's/:any//g' -e 's/|/ /g' \
			-e 's/  */ /g' -e 's/^ *//' -e 's/ *$//' \
		| grep -v '^$' || true
}

## The packages of $@ that are of the task (the Task field of the archive).
of_task() {
	[[ $# -gt 0 ]] || return 0
	apt-cache show --no-all-versions "$@" 2>/dev/null \
		| awk -v task="${task}" '
			/^Package: / { pkg = $2 }
			/^Task: / {
				n = split(substr($0, 7), tasks, ", *")
				for (i = 1; i <= n; i++) if (tasks[i] == task) print pkg
			}' || true
}

declare -A manual=() keep=() in_list=()
while read -r name; do
	manual[${name%:*}]=1
done < <(apt-mark showmanual)

## The first alternatives of the relations of g-unity7-desktop are kept.
while read -r name _; do
	keep[${name}]=1
done < <(relations "${meta}" "Depends Recommends Suggests")

## The one-line description of a package, installed or of the archive.
summary() {
	if installed "$1"; then
		dpkg-query -W -f='${binary:Summary}' "$1" 2>/dev/null || true
	else
		apt-cache show --no-all-versions "$1" 2>/dev/null \
			| awk '/^Description(-[[:alnum:]_]+)?: / { sub(/^[^:]+: /, ""); print; exit }' || true
	fi
}

## True if the archive has a version of $1 to install (the output of apt-cache
##  policy is translated).
has_candidate() {
	local candidate
	candidate=$(LC_ALL=C apt-cache policy "$1" 2>/dev/null | awk '/^  Candidate: / { print $2 }')
	[[ -n ${candidate} && ${candidate} != "(none)" ]]
}

## The words of $@ as "a, b and c".
and_list() {
	local out=$1
	shift
	while [[ $# -gt 1 ]]; do
		out+=", $1"
		shift
	done
	[[ $# -eq 0 ]] || out+=" and $1"
	echo "${out}"
}

## The relations of g-unity7-desktop to choose from. Relations with the same
##  first alternative and one other alternative each are one relation of the
##  first alternative or all the other ones, a set joined with "+" (Debian has
##  no "mate-utils | (baobab gnome-logs gnome-screenshot)", g-unity7-desktop
##  recommends "mate-utils | baobab, mate-utils | gnome-logs, ...").
mapfile -t relations_list < <(relations "${meta}" "Depends Recommends")
declare -A pairs=() pair_set=()
for group in "${relations_list[@]}"; do
	read -ra names <<< "${group}"
	[[ ${#names[@]} -eq 2 ]] || continue
	pairs[${names[0]}]=$(( ${pairs[${names[0]}]:-0} + 1 ))
	pair_set[${names[0]}]+=${pair_set[${names[0]}]:++}${names[1]}
done
groups=()
for group in "${relations_list[@]}"; do
	read -ra names <<< "${group}"
	if [[ ${#names[@]} -eq 2 && ${pairs[${names[0]}]} -gt 1 ]]; then
		[[ -n ${pair_set[${names[0]}]} ]] || continue
		groups+=( "${names[0]} ${pair_set[${names[0]}]}" )
		pair_set[${names[0]}]=
	else
		groups+=( "${group}" )
	fi
done

## A relation as text, with its sets.
relation_text() {
	local text=${1// / | }
	echo "${text//+/ + }"
}

## The installed packages of the alternatives $@ (a set joined with "+").
installed_of() {
	local name part parts
	for name in "$@"; do
		read -ra parts <<< "${name//+/ }"
		for part in "${parts[@]}"; do
			installed "${part}" && echo "${part}"
		done
	done
	return 0
}

## The packages of an alternative to install with it: not installed, in the
##  archive.
missing_of() {
	local part
	for part in ${1//+/ }; do
		installed "${part}" || ! has_candidate "${part}" || echo "${part}"
	done
	return 0
}

## True if a package of the alternative $1 is decided already.
decided() {
	local part
	for part in ${1//+/ }; do
		[[ -z ${spared[${part}]:-} && -z ${reason[${part}]:-} ]] || return 0
	done
	return 1
}

## The choices of the relations with more installed alternatives or with
##  another alternative installed instead of the first one: the kept
##  packages (spared[]) are not marked, the installed packages of the other
##  alternatives are removed (reason[]), of "change nothing" no package is
##  marked or removed.
declare -A spared=() reason=()
candidates_remove=() install=() unchanged=() asked=
for group in "${groups[@]}"; do
	read -ra names <<< "${group}"
	[[ ${#names[@]} -gt 1 ]] || continue
	first_name=${names[0]}
	## The alternatives with an installed package not decided yet, a first
	##  alternative of another relation is not one of them
	present=()
	for name in "${names[@]}"; do
		[[ ${name} == "${first_name}" || -z ${keep[${name}]:-} ]] || continue
		[[ -n $(installed_of "${name}") ]] && ! decided "${name}" || continue
		present+=( "${name}" )
	done
	[[ ${#present[@]} -gt 0 ]] || continue

	## Asked with two installed alternatives, or with another one installed
	##  instead of the first one the archive has
	if installed "${first_name}" || ! has_candidate "${first_name}" || decided "${first_name}"; then
		[[ ${#present[@]} -gt 1 ]] || continue
	fi

	## The alternatives in the order of the relation: an installed one is kept,
	##  another one installed if the archive has it
	options=() actions=() default=
	for name in "${names[@]}"; do
		[[ ${name} == "${first_name}" || -z ${keep[${name}]:-} ]] || continue
		mapfile -t missing < <(missing_of "${name}")
		if [[ " ${present[*]} " == *" ${name} "* ]]; then
			if [[ ${name} == *+* ]]; then
				## A set: the missing packages are installed with it
				mapfile -t parts < <(installed_of "${name}")
				label="keep $(and_list "${parts[@]}")"
				[[ ${#missing[@]} -eq 0 ]] || label+=", install $(and_list "${missing[@]}")"
			else
				label="keep ${name}: $(summary "${name}")"
			fi
			actions+=( "keep ${name}" )
		else
			[[ ${#missing[@]} -gt 0 ]] && ! decided "${name}" || continue
			if [[ ${name} == *+* ]]; then
				label="install $(and_list "${missing[@]}")"
			else
				label="install ${name}: $(summary "${name}")"
			fi
			actions+=( "install ${name}" )
		fi
		if [[ ${name} == "${first_name}" ]]; then
			label+=" (recommended)"
			default=${#actions[@]}
		fi
		options+=( "${label}" )
	done
	## Of a single installed alternative "keep" changes nothing
	if [[ ${#present[@]} -gt 1 ]]; then
		options+=( "change nothing, I will decide myself" )
		actions+=( "nothing" )
	fi
	default=${default:-${#actions[@]}}

	spinner_stop
	if [[ -z ${asked} ]]; then
		echo "For some applications (terminal, image viewer, …) another package than the"
		echo "recommended one, or several packages, are installed."
		if [[ -n ${yes} ]]; then
			echo "The recommended package is kept or installed, the others are removed."
		else
			echo "Choose the package to keep, the others are removed (Enter takes the number"
			echo "in brackets)."
		fi
		echo
		asked=1
	fi
	mapfile -t parts < <(installed_of "${present[@]}")
	if [[ ${#present[@]} -gt 1 ]]; then
		echo "$(and_list "${parts[@]}") are installed:"
	elif [[ ${#parts[@]} -gt 1 ]]; then
		echo "$(and_list "${parts[@]}") are installed instead of ${first_name}:"
	else
		echo "${parts[0]} is installed instead of ${first_name}:"
	fi
	if [[ -n ${yes} ]]; then
		answer=${default}
		echo "  ${options[answer - 1]}"
	else
		for i in "${!options[@]}"; do
			echo "  $(( i + 1 ))) ${options[i]}"
		done
		while :; do
			read -r -p "Choice [${default}]: " answer \
				|| die "no answer, use --yes to take the recommended choices"
			answer=${answer:-${default}}
			[[ ${answer} =~ ^[1-9][0-9]*$ && ${answer} -le ${#actions[@]} ]] && break
			echo "Give a number from 1 to ${#actions[@]}."
		done
	fi
	echo
	spinner_start

	action=${actions[answer - 1]}
	case ${action} in
		nothing)
			while read -r part; do
				spared[${part}]=1
			done < <(installed_of "${present[@]}")
			unchanged+=( "$(relation_text "${group}")" )
			;;
		install\ *|keep\ *)
			kept=${action#* }
			if [[ ${action} == install\ * ]]; then
				mapfile -t parts < <(missing_of "${kept}")
				if [[ ${#parts[@]} -gt 1 ]]; then
					why="$(and_list "${parts[@]}") are installed instead"
				else
					why="${parts[0]} is installed instead"
				fi
			else
				why="you keep $(and_list ${kept//+/ })"
			fi
			## The kept alternative, its missing packages installed
			for part in ${kept//+/ }; do
				spared[${part}]=1
				installed "${part}" || ! has_candidate "${part}" || install+=( "${part}" )
			done
			for name in "${present[@]}"; do
				[[ ${name} == "${kept}" ]] && continue
				while read -r part; do
					reason[${part}]=${why}
					candidates_remove+=( "${part}" )
				done < <(installed_of "${name}")
			done
			;;
	esac
done

## Firefox and Thunderbird: the packages of Ubuntu install the snaps, the PPA has
##  them as debs with the global menu of Unity (a lower version, g-unity7-apt-pin
##  keeps the packages of Ubuntu until the deb is installed here, the deb then
##  links its pin). With the deb chosen, the profiles of the snap are copied for
##  every user who has no profile of the deb yet, then the snap is removed.
moz_install=() moz_snap_remove=() moz_copy=() moz_lines=()

## The version of $1 in the G Unity⁷ PPA (also the staging PPA), empty if none.
ppa_version() {
	LC_ALL=C apt-cache madison "$1" 2>/dev/null \
		| awk -F'|' '$3 ~ /c4pp4\/g-unity7/ { gsub(/ /, "", $2); print $2; exit }'
}

## True if the snap $1 is installed.
snap_installed() {
	command -v snap >/dev/null && snap list "$1" >/dev/null 2>&1
}

## The users (UID 1000 to 59999) with a profile of the snap ($1, relative to the
##  home) and no profile of the deb ($2) yet, as "user:home".
profiles_to_copy() {
	local user uid home
	while IFS=: read -r user _ uid _ _ home _; do
		[[ ${uid} -ge 1000 && ${uid} -lt 60000 && -d ${home} ]] || continue
		[[ -d ${home}/$1 && ! -e ${home}/$2 ]] && echo "${user}:${home}"
	done < <(getent passwd)
	return 0
}

## moz_choice <package> <profile of the snap> <profile of the deb> <name>
moz_choice() {
	local pkg=$1 snap_profile=$2 deb_profile=$3 app=$4
	local ppa status deb_installed= snap= users=() copy_text options=() actions=() default=1 i answer u
	ppa=$(ppa_version "${pkg}")
	[[ -n ${ppa} ]] || return 0
	status=$(dpkg-query -W -f='${db:Status-Status} ${Version}' "${pkg}" 2>/dev/null) || true
	[[ ${status} == "installed "*+gu7* ]] && deb_installed=1
	snap_installed "${pkg}" && snap=1
	## Nothing to choose without the snap
	[[ -n ${snap} ]] || return 0

	mapfile -t users < <(profiles_to_copy "${snap_profile}" "${deb_profile}")
	copy_text=
	[[ ${#users[@]} -eq 0 ]] || copy_text=", copy the profiles of the snap of $(and_list "${users[@]%%:*}")"
	if [[ -n ${deb_installed} ]]; then
		options=( "remove the snap${copy_text} (recommended)" "keep the snap too" )
		actions=( snap nothing )
	else
		options=( "install ${app} of G Unity⁷ with the global menu${copy_text}, remove the snap (recommended)"
			"keep the snap of Ubuntu" )
		actions=( deb nothing )
	fi

	spinner_stop
	if [[ -n ${deb_installed} ]]; then
		echo "${app} of G Unity⁷ and the snap of ${app} are installed:"
	else
		echo "${app} is the snap of Ubuntu, G Unity⁷ has it with the global menu of Unity:"
	fi
	if [[ -n ${yes} ]]; then
		answer=${default}
		echo "  ${options[answer - 1]}"
	else
		for i in "${!options[@]}"; do
			echo "  $(( i + 1 ))) ${options[i]}"
		done
		while :; do
			read -r -p "Choice [${default}]: " answer \
				|| die "no answer, use --yes to take the recommended choices"
			answer=${answer:-${default}}
			[[ ${answer} =~ ^[1-9][0-9]*$ && ${answer} -le ${#actions[@]} ]] && break
			echo "Give a number from 1 to ${#actions[@]}."
		done
	fi
	echo
	spinner_start

	case ${actions[answer - 1]} in
		nothing)
			moz_lines+=( "${app}: unchanged" )
			return 0
			;;
		deb)
			moz_install+=( "${pkg}=${ppa}" )
			moz_lines+=( "${app}: install ${pkg} ${ppa} of G Unity⁷" )
			;;
	esac
	## A running snap is not removed (the copy of an open profile is not consistent)
	if pgrep -f "/snap/${pkg}/" >/dev/null; then
		moz_lines+=( "${app}: the snap is running, close ${app} and run g-unity7-cleanup again to remove it" )
		return 0
	fi
	for u in "${users[@]}"; do
		moz_copy+=( "${u%%:*}:${u#*:}/${snap_profile}:${u#*:}/${deb_profile}" )
		moz_lines+=( "${app}: copy ${u#*:}/${snap_profile} to ${u#*:}/${deb_profile}" )
	done
	moz_snap_remove+=( "${pkg}" )
	moz_lines+=( "${app}: remove the snap (snapd saves a snapshot of its data)" )
}

moz_choice firefox snap/firefox/common/.mozilla/firefox .mozilla/firefox Firefox
moz_choice thunderbird snap/thunderbird/common/.thunderbird .thunderbird Thunderbird

mark=()
add_mark() {
	local name
	for name in "$@"; do
		[[ -n ${manual[${name}]:-} && -z ${keep[${name}]:-} && -z ${spared[${name}]:-} ]] \
			&& installed "${name}" || continue
		[[ -n ${in_list[${name}]:-} ]] || { mark+=( "${name}" ); in_list[${name}]=1; }
	done
}

## ubuntu-unity-desktop and the duplicates (the relations of the archive if it is removed already).
add_mark "${task}"
mapfile -t duplicates < <(relations "${task}" "Depends Recommends" | tr ' ' '\n')
add_mark "${duplicates[@]}"

## The packages of the task the installed duplicates and the alternatives to
##  remove depend on or recommend (not those of a package kept by a choice).
roots=( "${candidates_remove[@]}" )
for name in "${duplicates[@]}"; do
	[[ -z ${spared[${name}]:-} ]] && installed "${name}" && roots+=( "${name}" )
done
if [[ ${#roots[@]} -gt 0 ]]; then
	mapfile -t closure < <(apt-cache depends --recurse --installed --no-suggests --no-conflicts \
		--no-breaks --no-replaces --no-enhances "${roots[@]}" 2>/dev/null \
		| grep -v '^[ <]' | sort -u || true)
	candidates=()
	for name in "${closure[@]}"; do
		[[ -n ${manual[${name}]:-} && -z ${keep[${name}]:-} && -z ${spared[${name}]:-} ]] \
			&& candidates+=( "${name}" )
	done
	mapfile -t closure_of_task < <(of_task "${candidates[@]}")
	add_mark "${closure_of_task[@]}"
fi

## The marks applied to a copy of the apt state, the packages autoremove removes then.
tmp=$(mktemp -d)
states=${tmp}/extended_states
cp /var/lib/apt/extended_states "${states}" 2>/dev/null || : > "${states}"
[[ ${#mark[@]} -eq 0 ]] || apt-mark -o Dir::State::extended_states="${states}" auto "${mark[@]}" >/dev/null
declare -A autoremoved=()
while read -r name; do
	autoremoved[${name}]=1
done < <(apt-get -s -o Dir::State::extended_states="${states}" --purge autoremove 2>/dev/null \
	| awk '/^Purg / { print $2 }')

## The alternatives of the choices, without those other packages need (but
##  the packages autoremove removes anyway, e.g. ubuntu-unity-desktop).
install_args=( "${install[@]/%/+}" )
remove=() reasons=() needed_kept=()
for name in "${candidates_remove[@]}"; do
	others=
	while read -r other; do
		[[ ${other} == "${name}" || -n ${autoremoved[${other}]:-} ]] || others+="${other} "
	done < <(apt-get -s -o Dir::State::extended_states="${states}" --purge remove "${name}" \
		"${install_args[@]}" 2>/dev/null | awk '/^(Purg|Remv) / { print $2 }')
	if [[ -n ${others} ]]; then
		needed_kept+=( "${name} (needed by ${others% })" )
		continue
	fi
	remove+=( "${name}" )
	reasons+=( "${name} (${reason[${name}]})" )
done

## The duplicates autoremove keeps as an installed alternative of another
##  relation (lightdm-gtk-greeter of lightdm-greeter, xfwm4 of x-window-manager),
##  removed if no other package would be removed with them. The alternatives
##  of g-unity7-desktop are left to the choices.
declare -A of_meta=() in_remove=()
while read -r name; do
	of_meta[${name}]=1
done < <(relations "${meta}" "Depends Recommends Suggests" | tr ' ' '\n')
dup_remove=()
for name in "${duplicates[@]}"; do
	[[ -z ${of_meta[${name}]:-} && -z ${spared[${name}]:-} && -z ${autoremoved[${name}]:-} \
		&& -z ${in_remove[${name}]:-} ]] && installed "${name}" || continue
	in_remove[${name}]=1
	others=
	while read -r other; do
		[[ ${other} == "${name}" || -n ${autoremoved[${other}]:-} ]] || others+="${other} "
	done < <(apt-get -s -o Dir::State::extended_states="${states}" --purge remove "${name}" \
		"${install_args[@]}" 2>/dev/null | awk '/^(Purg|Remv) / { print $2 }')
	[[ -n ${others} ]] && continue
	remove+=( "${name}" )
	dup_remove+=( "${name}" )
done

## Preview with the marks applied to a copy of the apt state.
if [[ ${#remove[@]} -gt 0 || ${#install[@]} -gt 0 ]]; then
	apt_args=( --purge --autoremove remove "${remove[@]}" "${install_args[@]}" )
else
	apt_args=( --purge autoremove )
fi
simulation=$(apt-get -s -o Dir::State::extended_states="${states}" "${apt_args[@]}" 2>/dev/null)
mapfile -t removed < <(awk '/^Purg / { print $2 }' <<< "${simulation}")
mapfile -t installs < <(awk '/^Inst / { print $2 }' <<< "${simulation}")

## Only the marked packages apt removes then. The other ones stay needed (by
##  G Unity⁷ or by another desktop, e.g. ubuntu-desktop shares most of the
##  task), marking them would only change their state. apt removes the same
##  packages without them: a kept package and its dependencies stay needed.
declare -A removed_set=()
for name in "${removed[@]}"; do
	removed_set[${name}]=1
done
## The duplicates removed directly are not marked.
for name in "${dup_remove[@]}"; do
	removed_set[${name}]=
done
marked=()
for name in "${mark[@]}"; do
	[[ -z ${removed_set[${name}]:-} ]] || marked+=( "${name}" )
done
mark=( "${marked[@]}" )

if [[ ${#mark[@]} -eq 0 && ${#remove[@]} -eq 0 && ${#install[@]} -eq 0 \
	&& ${#moz_install[@]} -eq 0 && ${#moz_snap_remove[@]} -eq 0 ]]; then
	spinner_stop
	echo "Nothing to do, no package of Ubuntu Unity replaced by G Unity⁷ is left."
	[[ ${#unchanged[@]} -eq 0 ]] || printf 'Left unchanged by your choice: %s\n' "${unchanged[@]}"
	[[ ${#needed_kept[@]} -eq 0 ]] || printf 'Kept alternative other packages need: %s\n' "${needed_kept[@]}"
	[[ ${#moz_lines[@]} -eq 0 ]] || printf '%s\n' "${moz_lines[@]}"
	exit 0
fi

spinner_stop

## A list of packages side by side as apt shows it, or one item per line.
list_words() {
	local title=$1 width
	shift
	[[ $# -gt 0 ]] || return 0
	width=$(tput cols 2>/dev/null) || width=80
	echo "${title} ($#):"
	printf '%s\n' "$@" | awk -v width="${width}" '
		length(line) && length(line) + 1 + length($0) > width { print line; line = "" }
		{ line = length(line) ? line " " $0 : "  " $0 }
		END { if (length(line)) print line }'
	echo
}

list_lines() {
	local title=$1
	shift
	[[ $# -gt 0 ]] || return 0
	echo "${title} ($#):"
	printf '  %s\n' "$@"
	echo
}

list_words "Alternatives to install" "${install[@]}"
list_lines "Alternatives to remove" "${reasons[@]}"
list_words "Replaced by G Unity⁷, kept by apt as an alternative of another package, to remove" "${dup_remove[@]}"
list_words "Leftovers not needed or replaced by G Unity⁷, to mark for autoremove" "${mark[@]}"
list_lines "Left unchanged by your choice" "${unchanged[@]}"
list_lines "Kept alternatives other packages need" "${needed_kept[@]}"
list_lines "Firefox and Thunderbird" "${moz_lines[@]}"
list_words "Packages apt installs" "${installs[@]}"
## Purged as by apt (with the configuration files), marked with * as apt does
if [[ ${#removed[@]} -gt 0 ]]; then
	list_words "Packages apt removes" "${removed[@]/%/*}"
else
	echo "Packages apt removes: none"
	echo
fi
echo "To keep a package, mark it as manually installed first: sudo apt-mark manual <package>"

[[ -z ${dry_run} ]] || exit 0

if [[ -z ${yes} ]]; then
	read -r -p "Continue? [y/N] " answer
	[[ ${answer} == [yY]* ]] || { echo "Nothing changed."; exit 0; }
fi

[[ ${#mark[@]} -eq 0 ]] || apt-mark auto "${mark[@]}" >/dev/null
if [[ ${#mark[@]} -gt 0 || ${#remove[@]} -gt 0 || ${#install[@]} -gt 0 ]]; then
	apt-get -y "${apt_args[@]}"
fi
## The installed first alternatives are needed by g-unity7-desktop only, the
##  other ones are chosen by the user (as a package of @world).
install_auto=()
for name in "${install[@]}"; do
	[[ -z ${keep[${name}]:-} ]] || install_auto+=( "${name}" )
done
[[ ${#install_auto[@]} -eq 0 ]] || apt-mark auto "${install_auto[@]}" >/dev/null

## Firefox and Thunderbird of G Unity⁷ (a lower version than the packages of
##  Ubuntu, their pin comes with them), the profiles of the snaps, the snaps.
if [[ ${#moz_install[@]} -gt 0 ]]; then
	apt-get -y --allow-downgrades install "${moz_install[@]}"
fi
for entry in "${moz_copy[@]}"; do
	IFS=: read -r user src dst <<< "${entry}"
	[[ -e ${dst} ]] && continue
	mkdir -p "$(dirname "${dst}")"
	cp -a "${src}" "${dst}" || die "copying ${src} failed"
	chown "${user}": "$(dirname "${dst}")"
	echo "Copied ${src} to ${dst}"
done
for name in "${moz_snap_remove[@]}"; do
	snap remove "${name}"
done
