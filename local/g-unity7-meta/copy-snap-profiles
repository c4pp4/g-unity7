#!/usr/bin/python3 -I
## Copy the profiles of a Firefox or Thunderbird snap to the profile directory
##  of the G Unity⁷ package. g-unity7-cleanup runs it as the user whose
##  profiles they are: the user owns these directories and can replace any path
##  in them with a link, so the copy must not have more rights than the user.
##
## Usage: copy-snap-profiles <snap profile directory> <package profile directory>
##          <install hash> <adopt> [<switch id>]
##
##  If the package profile directory has no profiles.ini, the snap profiles are
##  copied as they are, and the snap's default profile becomes the default
##  profile of the package. Otherwise each snap profile is added to it, with
##  "(snap)" after its name, and no profile is replaced; the snap's default
##  profile becomes the default profile of the package only if <adopt> is
##  "adopt". A directory without profiles.ini that already has a file or
##  directory of the snap profile directory, such as a profile left behind, is
##  given an empty profiles.ini, and the snap profiles are added to it. If the
##  snap profile directory is the package profile directory (a link), nothing
##  is copied, and the snap's default profile becomes the default profile of
##  the package with <adopt>. The install hash belongs to the package directory
##  (/usr/lib/firefox) in profiles.ini and installs.ini; if it is empty, the
##  default profile does not change.
##
##  Each copy goes to a temporary directory next to the package profile
##  directory first and is moved into place when it is complete, so that an
##  error, such as a full disk, leaves no part of a profile behind. With
##  <switch id> (g-unity7-cleanup gives one for each switch from a snap to the
##  package), a copy that was completed in the same switch is not made again,
##  such as when the copy of another user stopped the run, unless the snap
##  changed the profiles since then.
##
##  cp -a and mv -T make the copies and move them into place, so that links,
##  special files and attributes are handled as cp and mv do.

import os
import re
import shutil
import subprocess
import sys
import tempfile

USAGE = ("usage: copy-snap-profiles <snap profile directory> <package profile directory> "
         "<install hash> <adopt> [<switch id>]")
## Written to the package profile directory when the copy of a switch is done
MARKER = ".g-unity7-snap-copy"
PROFILE_SECTION = re.compile(r"\[Profile[0-9]+\]")
PROFILE_NUMBER = re.compile(r"\[Profile([0-9]*)\]")
## The bytes of file names and contents that are not UTF-8 stay as they are
ENCODING = {"encoding": "utf-8", "errors": "surrogateescape", "newline": ""}


class Failure(Exception):
    """An error that stops the copy. Its text follows "copy-snap-profiles: "."""


def die(text):
    raise Failure(text)


def run(*command):
    """Run a command with the output of this program, and return whether it
    succeeded."""
    sys.stdout.flush()
    return subprocess.run(command).returncode == 0


def read_lines(path):
    """Return the lines of file path as awk reads them (split at a newline only,
    without the newline), or None if it cannot be read."""
    try:
        with open(path, **ENCODING) as file:
            lines = file.read().split("\n")
    except (OSError, ValueError):
        return None
    if lines[-1] == "":
        lines.pop()
    return lines


def file_text(path):
    """Return the text of file path without the newlines at its end, as $(< path)
    does, or "" if it cannot be read."""
    try:
        with open(path, **ENCODING) as file:
            return file.read().rstrip("\n")
    except (OSError, ValueError):
        return ""


def write(path, text, mode):
    """Write (mode "w") or append (mode "a") text to file path."""
    try:
        with open(path, mode, **ENCODING) as file:
            file.write(text)
    except OSError:
        die(f"cannot write {path}")


def entries(directory):
    """Return the names in directory as the globs * .[!.]* ..?* list them: those
    that do not start with a dot first, then the others, each sorted by bytes."""
    try:
        names = os.listdir(directory)
    except OSError:
        return []
    order = sorted(names, key=os.fsencode)
    return ([n for n in order if not n.startswith(".")]
            + [n for n in order if n.startswith(".") and not n.startswith("..")]
            + [n for n in order if n.startswith("..") and len(n) > 2])


def lexists(path):
    """Succeed if path exists, also as a link that points nowhere ([[ -e || -L ]])."""
    return os.path.lexists(path)


def moz_default_profile(path):
    """Return the path of the default profile of the snap in profiles.ini path:
    the profile with Default=1, or else the only profile. In a snap, Firefox and
    Thunderbird do not keep a profile for each install (nsToolkitProfileService),
    so they open this profile and ignore the install sections. Those in a snap
    profile directory come from Ubuntu's package before the snap and may name
    an older profile. The fields are split at each "=", as awk -F= does."""
    section = ""
    paths, only, count, default = {}, "", 0, None
    for line in read_lines(path) or []:
        if line.startswith("["):
            section = line
            continue
        if not PROFILE_SECTION.fullmatch(section):
            continue
        fields = line.split("=")
        value = fields[1] if len(fields) > 1 else ""
        if fields[0] == "Path":
            paths[section] = value
            only = value
            count += 1
        if fields[0] == "Default" and value == "1":
            default = section
    if default is not None:
        return paths.get(default, "")
    return only if count == 1 else ""


def ini_set_default(path, section, value):
    """Set Default=value in section [section] of ini file path, or add the
    section."""
    header = f"[{section}]"
    lines = read_lines(path) if os.path.isfile(path) else None
    if lines is not None and header in lines:
        out, inside = [], False
        for line in lines:
            if line.startswith("["):
                inside = line == header
                out.append(line)
                if inside:
                    out.append(f"Default={value}")
                continue
            if inside and line.startswith("Default="):
                continue
            out.append(line)
        write(path, "\n".join(out).rstrip("\n") + "\n", "w")
    else:
        write(path, f"\n[{section}]\nDefault={value}\nLocked=1\n", "a")


def moz_claim_profile(directory, install_hash, profile):
    """Make profile (a path relative to the profile directory) the profile of
    the package, as Firefox does on its first run. install_hash is the install
    hash of the package directory in profiles.ini and installs.ini. Without
    this, Firefox creates a new profile, because the compatibility.ini of a
    copied profile points to the snap."""
    if not install_hash or not profile:
        return
    ini_set_default(f"{directory}/profiles.ini", f"Install{install_hash}", profile)
    ini_set_default(f"{directory}/installs.ini", install_hash, profile)
    print(f"Set {directory}/{profile} as the default profile")


def free_name(name, directory, tmp):
    """Return a name for the copy of profile directory name in the package
    profile directory that neither it nor the temporary directory tmp has: the
    name itself, or with "-snap" added (the snap copied the old profiles of
    the Ubuntu package under the same names), or "-snap2" and so on."""
    def taken(new):
        return os.path.exists(f"{directory}/{new}") or os.path.exists(f"{tmp}/{new}")
    new = name
    if taken(new):
        new = f"{name}-snap"
    i = 2
    while taken(new):
        new = f"{name}-snap{i}"
        i += 1
    return new


def moz_group_member(directory, ids):
    """Succeed if the profile in directory belongs to one of the profile groups
    with the StoreIDs ids: Firefox writes the StoreID of its group to prefs.js."""
    try:
        with open(f"{directory}/prefs.js", "rb") as file:
            data = file.read()
    except OSError:
        return False
    return any(f'"toolkit.profiles.storeID", "{store}"'.encode("utf-8", "surrogateescape") in data
               for store in ids)


def profile_entries(path):
    """Return the profiles in profiles.ini path as (name, path, IsRelative,
    StoreID, ShowSelector): the sections [ProfileN] with a Path. A key ends at
    the first "=", and a line without "=" is its own value."""
    found, section, fields = [], "", {}

    def out():
        if PROFILE_SECTION.fullmatch(section) and fields.get("Path", ""):
            found.append((fields.get("Name", ""), fields["Path"], fields.get("IsRelative", ""),
                          fields.get("StoreID", ""), fields.get("ShowSelector", "")))

    for line in read_lines(path) or []:
        if line.startswith("["):
            out()
            section, fields = line, {}
            continue
        key, sep, value = line.partition("=")
        if not sep:
            value = line
        if key in ("Name", "Path", "IsRelative", "StoreID", "ShowSelector"):
            fields[key] = value
    out()
    return found


def next_profile_number(path):
    """Return the number after the highest [ProfileN] in profiles.ini path, or 0."""
    numbers = [m.group(1) for line in read_lines(path) or [] if (m := PROFILE_NUMBER.fullmatch(line))]
    if not numbers:
        return 0
    highest = max(numbers, key=lambda n: (int(n) if n else 0, n))
    return int(highest) + 1 if highest else 0


def newer_than(top, reference):
    """Succeed if directory top, or a file in it, was modified after reference,
    as find "top/" -newer reference -print -quit: links are not followed, and
    what cannot be read is left out."""
    try:
        since = os.lstat(reference).st_mtime_ns
        if os.stat(f"{top}/").st_mtime_ns > since:
            return True
    except OSError:
        return False
    for dirpath, dirnames, filenames in os.walk(f"{top}/"):
        for name in dirnames + filenames:
            try:
                if os.lstat(os.path.join(dirpath, name)).st_mtime_ns > since:
                    return True
            except OSError:
                pass
    return False


class Copy:
    """The copy of the snap profile directory src to the package profile
    directory dst."""

    def __init__(self, src, dst, install_hash, adopt, switch):
        self.src, self.dst, self.hash, self.adopt, self.switch = src, dst, install_hash, adopt, switch
        ## The temporary directory of the copies, removed at the end
        self.tmp = None

    def make_tmp(self, directory):
        """Create the temporary directory in directory, on the file system of the
        package profile directory, so that a complete copy is only renamed."""
        try:
            self.tmp = tempfile.mkdtemp(prefix=".g-unity7-copy.", dir=directory)
        except OSError:
            die(f"cannot create a temporary directory in {directory}")

    def remove_tmp(self):
        if self.tmp:
            shutil.rmtree(self.tmp, ignore_errors=True)

    def mark_done(self):
        """Record that the copy of this switch is done."""
        if self.switch:
            write(f"{self.dst}/{MARKER}", f"{self.switch} {self.src}\n", "w")

    def move(self, source, target, failure):
        if not run("mv", "-T", "--", source, target):
            die(failure)

    def merge_profiles(self, adopt):
        """Add the profiles in the snap profile directory to the package profile
        directory, which has its own profiles.ini: copy each profile directory
        (under a free name, see free_name) and add it to profiles.ini with
        "(snap)" after its name. No profile is replaced. With adopt, the snap's
        default profile becomes the default profile of the package; otherwise
        the default stays. Only profiles in a directory of their own in the snap
        profile directory are copied, as Firefox and Thunderbird create them,
        not those with an absolute path or a path with "/".

        A profile group of Firefox (the Profiles menu) has one profile in
        profiles.ini, with the StoreID of the group. Its other profiles are only
        in "Profile Groups/<StoreID>.sqlite", with paths relative to the profile
        directory, and have the StoreID in prefs.js. They are copied with the
        database under the same names, so that these paths stay valid, and the
        copy fails if a name is taken. Other directories with prefs.js or
        times.json that profiles.ini does not list, such as a profile removed
        from the list but kept, are copied like the listed profiles but not
        added to profiles.ini.

        All profiles are copied to the temporary directory before the first one
        is moved into place, so that an error leaves the package profile
        directory as it was."""
        src, dst = self.src, self.dst
        default = moz_default_profile(f"{src}/profiles.ini")
        default_new = ""
        n = next_profile_number(f"{dst}/profiles.ini")
        self.make_tmp(dst)
        tmp = self.tmp
        listed, ids, copied, unlisted = set(), [], [], []
        for name, path, relative, store, selector in profile_entries(f"{src}/profiles.ini"):
            if relative == "1":
                listed.add(path)
            if not (relative == "1" and path and "/" not in path and path not in (".", "..")
                    and os.path.isdir(f"{src}/{path}")):
                continue
            if store:
                ids.append(store)
                new = path
                if os.path.exists(f"{dst}/{new}") or os.path.exists(f"{tmp}/{new}"):
                    die(f"cannot add the profile group of {src}/{path} to {dst}: {dst}/{new} exists")
            else:
                new = free_name(path, dst, tmp)
            if not run("cp", "-a", "--", f"{src}/{path}", f"{tmp}/{new}"):
                die(f"cannot copy {src}/{path}")
            copied.append((name, path, new, store, selector))
        ## The profiles that profiles.ini does not list
        for base in entries(src):
            folder = f"{src}/{base}"
            if (base.startswith(".") or not os.path.isdir(folder) or os.path.islink(folder)
                    or base in listed or base == "Profile Groups"):
                continue
            if not (os.path.isfile(f"{folder}/prefs.js") or os.path.isfile(f"{folder}/times.json")):
                continue
            if ids and moz_group_member(folder, ids):
                new = base
                if os.path.exists(f"{dst}/{new}") or os.path.exists(f"{tmp}/{new}"):
                    die(f"cannot add the profile group of {src} to {dst}: {dst}/{new} exists")
            else:
                new = free_name(base, dst, tmp)
            if not run("cp", "-a", "--", folder, f"{tmp}/{new}"):
                die(f"cannot copy {folder}")
            unlisted.append((base, new))
        ## The databases of the profile groups
        groups = f"{src}/Profile Groups"
        if ids and os.path.isdir(groups) and not os.path.islink(groups):
            try:
                os.mkdir(f"{tmp}/Profile Groups")
            except OSError:
                die(f"cannot create {tmp}/Profile Groups")
            for name in entries(groups):
                file = f"{groups}/{name}"
                if name.startswith(".") or not os.path.isfile(file) or os.path.islink(file):
                    continue
                if os.path.exists(f"{dst}/Profile Groups/{name}"):
                    die(f"cannot add the profile group of {src} to {dst}: {dst}/Profile Groups/{name} exists")
                if not run("cp", "-a", "--", file, f"{tmp}/Profile Groups/"):
                    die(f"cannot copy {file}")

        ## The group databases and the unlisted profiles first: nothing uses them
        ##  before the profiles are added to profiles.ini
        if os.path.isdir(f"{tmp}/Profile Groups"):
            try:
                os.makedirs(f"{dst}/Profile Groups", exist_ok=True)
            except OSError:
                die(f"cannot create {dst}/Profile Groups")
            for name in entries(f"{tmp}/Profile Groups"):
                if name.startswith("."):
                    continue
                self.move(f"{tmp}/Profile Groups/{name}", f"{dst}/Profile Groups/{name}",
                          f"cannot move the copy of {src}/Profile Groups/{name} to {dst}/Profile Groups")
                print(f"Copied {src}/Profile Groups/{name} to {dst}/Profile Groups/{name}")
        for base, new in unlisted:
            self.move(f"{tmp}/{new}", f"{dst}/{new}", f"cannot move the copy of {src}/{base} to {dst}/{new}")
            print(f"Copied {src}/{base} to {dst}/{new} (not in profiles.ini)")
        for name, path, new, store, selector in copied:
            self.move(f"{tmp}/{new}", f"{dst}/{new}", f"cannot move the copy of {src}/{path} to {dst}/{new}")
            text = f"\n[Profile{n}]\nName={name} (snap)\nIsRelative=1\nPath={new}\n"
            if store:
                text += f"StoreID={store}\n"
            if selector:
                text += f"ShowSelector={selector}\n"
            write(f"{dst}/profiles.ini", text, "a")
            print(f"Copied {src}/{path} to {dst}/{new}")
            n += 1
            if path == default:
                default_new = new
        if adopt:
            moz_claim_profile(dst, self.hash, default_new)

    def main(self):
        src, dst = self.src, self.dst
        ## A copy of this switch is not made again, unless the snap changed the
        ##  profiles since then
        marker = f"{dst}/{MARKER}"
        if (self.switch and os.path.isfile(marker) and not os.path.islink(marker)
                and file_text(marker) == f"{self.switch} {src}" and not newer_than(src, marker)):
            print(f"{src} was copied to {dst} before, nothing to copy")
            return
        ## The Thunderbird snap links its profile directory to ~/.thunderbird if
        ##  that has profiles when the snap starts for the first time (Ubuntu's
        ##  package before 24.04). The package then uses the same profiles.
        if os.path.isdir(dst) and os.path.realpath(src) == os.path.realpath(dst):
            print(f"{src} is {dst}, nothing to copy")
            if self.adopt:
                moz_claim_profile(dst, self.hash, moz_default_profile(f"{dst}/profiles.ini"))
            return
        if os.path.isfile(f"{dst}/profiles.ini"):
            self.merge_profiles(self.adopt)
            self.mark_done()
            return
        if os.path.isdir(dst):
            ## Copied into the directory as they are only if no name is taken
            if any(lexists(f"{dst}/{name}") for name in entries(src)):
                write(f"{dst}/profiles.ini", "[General]\nStartWithLastProfile=1\nVersion=2\n", "w")
                self.merge_profiles("adopt")
                self.mark_done()
                return
            self.make_tmp(dst)
            if not run("cp", "-a", "--", f"{src}/.", f"{self.tmp}/"):
                die(f"cannot copy {src}")
            ## profiles.ini last: without it, the directory is not a profile directory
            for name in entries(self.tmp):
                if name != "profiles.ini":
                    self.move(f"{self.tmp}/{name}", f"{dst}/{name}", f"cannot move the copy of {src}/{name} to {dst}")
            self.move(f"{self.tmp}/profiles.ini", f"{dst}/profiles.ini",
                      f"cannot move the copy of {src}/profiles.ini to {dst}")
        else:
            parent = os.path.dirname(dst)
            try:
                os.makedirs(parent, exist_ok=True)
            except OSError:
                die(f"cannot create {parent}")
            self.make_tmp(parent)
            if not run("cp", "-a", "--", src, f"{self.tmp}/copy"):
                die(f"cannot copy {src}")
            ## Private, as Firefox and Thunderbird create it. cp keeps the mode of
            ##  the snap directory, which other users can read.
            try:
                os.chmod(f"{self.tmp}/copy", os.stat(f"{self.tmp}/copy").st_mode & 0o7700)
            except OSError:
                die(f"cannot change the mode of the copy of {src}")
            self.move(f"{self.tmp}/copy", dst, f"cannot move the copy of {src} to {dst}")
        print(f"Copied {src} to {dst}")
        moz_claim_profile(dst, self.hash, moz_default_profile(f"{dst}/profiles.ini"))
        self.mark_done()


def main(argv):
    os.umask(0o077)
    if os.geteuid() == 0:
        die("run it as the user whose profiles they are, not as root")
    if len(argv) not in (4, 5):
        die(USAGE)
    src, dst, install_hash, adopt = argv[:4]
    switch = argv[4] if len(argv) == 5 else ""
    if not os.path.isfile(f"{src}/profiles.ini"):
        die(f"cannot read {src}/profiles.ini")
    copy = Copy(src, dst, install_hash, "adopt" if adopt == "adopt" else "", switch)
    try:
        copy.main()
    finally:
        copy.remove_tmp()


if __name__ == "__main__":
    sys.stdout.reconfigure(line_buffering=True)
    try:
        main(sys.argv[1:])
    except (Failure, OSError) as error:
        print(f"copy-snap-profiles: {error}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
