#!/bin/sh
set -e

# G Unity⁷: the panel directories of the Yaru accent themes are symlinks to the
# Yaru and Yaru-dark ones, but dh_icons updates only the caches of these two. A
# stale cache makes GTK use the Yaru icon for Yaru-purple-dark
if [ "$1" = "configure" ] && command -v update-icon-caches >/dev/null; then
	update-icon-caches /usr/share/icons/Yaru-*
fi

#DEBHELPER#
