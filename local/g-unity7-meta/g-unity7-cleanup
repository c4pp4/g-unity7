#!/bin/bash
## Mark the packages of Ubuntu Unity that G Unity⁷ does not use as automatically
##  installed, so that "apt --purge autoremove" removes them.
##
## The installer of Ubuntu Unity installs the ubuntu-unity-desktop task and apt
##  marks its packages as manually installed, autoremove never removes them.
##  Marked are, if manually installed:
##  - ubuntu-unity-desktop
##  - the packages ubuntu-unity-desktop depends on or recommends and
##    g-unity7-desktop does not depend on, recommend or suggest (the duplicates)
##  - the packages of the task the duplicates depend on or recommend
##  A marked package that is still needed by another package is kept by autoremove.

set -euo pipefail

meta=g-unity7-desktop
task=ubuntu-unity-desktop

usage() {
	cat <<-EOF
		Usage: g-unity7-cleanup [-n|--dry-run] [-y|--yes]

		Mark the packages of Ubuntu Unity that G Unity⁷ does not use as automatically
		installed and show what "apt --purge autoremove" will remove then.

		  -n, --dry-run  only show the packages, change nothing (no root needed)
		  -y, --yes      do not ask for confirmation
	EOF
}

dry_run=
yes=
while [[ $# -gt 0 ]]; do
	case $1 in
		-n|--dry-run) dry_run=1 ;;
		-y|--yes) yes=1 ;;
		-h|--help) usage; exit 0 ;;
		*) usage >&2; exit 2 ;;
	esac
	shift
done

die() {
	echo "g-unity7-cleanup: $*" >&2
	exit 1
}

[[ -n ${dry_run} || ${EUID} -eq 0 ]] || die "run it as root (sudo g-unity7-cleanup) or with --dry-run"

installed() {
	[[ $(dpkg-query -W -f='${db:Status-Status}' "$1" 2>/dev/null) == installed ]]
}

installed "${meta}" || die "${meta} is not installed"

## The package names of the Depends, Recommends and Suggests fields of a package
##  ($1, the installed version or the candidate of the archive), one per line.
relations() {
	apt-cache show --no-all-versions "$1" 2>/dev/null \
		| awk -v fields="${2:-Depends Recommends Suggests}" '
			BEGIN { n = split(fields, f, " "); for (i = 1; i <= n; i++) want[f[i] ":"] = 1 }
			/^[^ ]/ { take = ($1 in want) }
			take { sub(/^[^ ]+: /, ""); print }' \
		| tr ',|' '\n\n' \
		| sed -e 's/([^)]*)//g' -e 's/\[[^]]*\]//g' -e 's/:any//' -e 's/^ *//' -e 's/ *$//' \
		| grep -v '^$' || true
}

declare -A manual=() keep=()
while read -r name; do
	manual[${name%:*}]=1
done < <(apt-mark showmanual)
while read -r name; do
	keep[${name}]=1
done < <(relations "${meta}")

mark=()
add() {
	local name
	for name in "$@"; do
		[[ -n ${manual[${name}]:-} && -z ${keep[${name}]:-} ]] && installed "${name}" || continue
		[[ " ${mark[*]} " == *" ${name} "* ]] || mark+=( "${name}" )
	done
}

## ubuntu-unity-desktop and the duplicates (the relations of the archive if it is removed already).
add "${task}"
mapfile -t duplicates < <(relations "${task}" "Depends Recommends")
add "${duplicates[@]}"

## The packages of the task the installed duplicates depend on or recommend.
installed_duplicates=()
for name in "${duplicates[@]}"; do
	installed "${name}" && installed_duplicates+=( "${name}" )
done
if [[ ${#installed_duplicates[@]} -gt 0 ]]; then
	mapfile -t closure < <(apt-cache depends --recurse --installed --no-suggests --no-conflicts \
		--no-breaks --no-replaces --no-enhances "${installed_duplicates[@]}" 2>/dev/null \
		| grep -v '^[ <]' | sort -u || true)
	candidates=()
	for name in "${closure[@]}"; do
		[[ -n ${manual[${name}]:-} && -z ${keep[${name}]:-} ]] && candidates+=( "${name}" )
	done
	if [[ ${#candidates[@]} -gt 0 ]]; then
		mapfile -t in_task < <(apt-cache show --no-all-versions "${candidates[@]}" 2>/dev/null \
			| awk -v task="${task}" '
				/^Package: / { pkg = $2 }
				/^Task: / {
					n = split(substr($0, 7), tasks, ", *")
					for (i = 1; i <= n; i++) if (tasks[i] == task) print pkg
				}' || true)
		add "${in_task[@]}"
	fi
fi

if [[ ${#mark[@]} -eq 0 ]]; then
	echo "Nothing to mark, no manually installed package of Ubuntu Unity is left."
	exit 0
fi

## Preview the autoremove with the marks applied to a copy of the apt state.
tmp=$(mktemp -d)
trap 'rm -rf "${tmp}"' EXIT
states=${tmp}/extended_states
cp /var/lib/apt/extended_states "${states}" 2>/dev/null || : > "${states}"
apt-mark -o Dir::State::extended_states="${states}" auto "${mark[@]}" >/dev/null
mapfile -t remove < <(apt-get -s -o Dir::State::extended_states="${states}" --purge autoremove 2>/dev/null \
	| awk '/^Purg / { print $2 }')

echo "Packages to mark as automatically installed (${#mark[@]}):"
printf '  %s\n' "${mark[@]}"
echo
echo "\"apt --purge autoremove\" will remove then (${#remove[@]}):"
if [[ ${#remove[@]} -gt 0 ]]; then
	printf '  %s\n' "${remove[@]}"
else
	echo "  nothing"
fi
echo
echo "To keep a package, mark it as manually installed afterwards: sudo apt-mark manual <package>"

[[ -z ${dry_run} ]] || exit 0

if [[ -z ${yes} ]]; then
	read -r -p "Mark the packages as automatically installed? [y/N] " answer
	[[ ${answer} == [yY]* ]] || { echo "Nothing changed."; exit 0; }
fi

apt-mark auto "${mark[@]}" >/dev/null
echo "Done. Remove the packages with: sudo apt --purge autoremove"
